{
  "name": "predictions",
  "kind": "product",
  "description": "Prediction markets on the core: markets and an exchange composing ankka-predictions (spec 023)",
  "dependencies": [
    {
      "module": "core",
      "range": ">=0.4.0 <1.0.0"
    }
  ],
  "services": [
    {
      "name": "markets",
      "descriptor": {
        "image": "europe-west1-docker.pkg.dev/eitheror/casino/markets:0.0.0",
        "expose": true,
        "runtime": "0.14.2",
        "resources": {
          "instanceType": "medium"
        },
        "env": [
          {
            "name": "CASINO_PROJECT",
            "key": "casino-project"
          },
          {
            "name": "CASINO_BRAND",
            "key": "casino-brand"
          },
          {
            "name": "CASINO_REAL_MONEY",
            "key": "casino-real-money"
          },
          {
            "name": "ANKKA_AUTH_ISSUERS",
            "value": "player,staff"
          },
          {
            "name": "ANKKA_AUTH_REALM",
            "key": "auth-realm"
          },
          {
            "name": "ANKKA_AUTH_PLAYER_ISSUER",
            "key": "auth-player-issuer"
          },
          {
            "name": "ANKKA_AUTH_PLAYER_JWKS_URL",
            "key": "auth-player-jwks-url"
          },
          {
            "name": "ANKKA_AUTH_PLAYER_AUDIENCE",
            "key": "auth-player-audience"
          },
          {
            "name": "ANKKA_AUTH_STAFF_ISSUER",
            "key": "auth-staff-issuer"
          },
          {
            "name": "ANKKA_AUTH_STAFF_JWKS_URL",
            "key": "auth-staff-jwks-url"
          },
          {
            "name": "ANKKA_AUTH_STAFF_AUDIENCE",
            "value": "eitheror-casino"
          },
          {
            "name": "PLAYER_SITE_BASE",
            "key": "player-site-base"
          },
          {
            "name": "KEYCLOAK_ISSUER_BASE",
            "key": "keycloak-issuer-base"
          },
          {
            "name": "KEYCLOAK_JWKS_BASE",
            "key": "keycloak-jwks-base"
          },
          {
            "name": "PREDICTIONS_CATEGORIES",
            "key": "predictions-categories"
          },
          {
            "name": "PREDICTIONS_CURRENCIES",
            "key": "predictions-currencies"
          },
          {
            "name": "PREDICTIONS_MAX_ORDER_COST",
            "key": "predictions-max-order-cost"
          },
          {
            "name": "PREDICTIONS_MAX_POSITION",
            "key": "predictions-max-position"
          },
          {
            "name": "PREDICTIONS_TAKER_FEE_BPS",
            "key": "predictions-taker-fee-bps"
          }
        ]
      }
    },
    {
      "name": "exchange",
      "descriptor": {
        "image": "europe-west1-docker.pkg.dev/eitheror/casino/exchange:0.0.0",
        "expose": true,
        "runtime": "0.14.2",
        "resources": {
          "instanceType": "medium"
        },
        "env": [
          {
            "name": "CASINO_PROJECT",
            "key": "casino-project"
          },
          {
            "name": "CASINO_BRAND",
            "key": "casino-brand"
          },
          {
            "name": "CASINO_REAL_MONEY",
            "key": "casino-real-money"
          },
          {
            "name": "ANKKA_AUTH_ISSUERS",
            "value": "player,staff"
          },
          {
            "name": "ANKKA_AUTH_REALM",
            "key": "auth-realm"
          },
          {
            "name": "ANKKA_AUTH_PLAYER_ISSUER",
            "key": "auth-player-issuer"
          },
          {
            "name": "ANKKA_AUTH_PLAYER_JWKS_URL",
            "key": "auth-player-jwks-url"
          },
          {
            "name": "ANKKA_AUTH_PLAYER_AUDIENCE",
            "key": "auth-player-audience"
          },
          {
            "name": "ANKKA_AUTH_STAFF_ISSUER",
            "key": "auth-staff-issuer"
          },
          {
            "name": "ANKKA_AUTH_STAFF_JWKS_URL",
            "key": "auth-staff-jwks-url"
          },
          {
            "name": "ANKKA_AUTH_STAFF_AUDIENCE",
            "value": "eitheror-casino"
          },
          {
            "name": "PLAYER_SITE_BASE",
            "key": "player-site-base"
          },
          {
            "name": "KEYCLOAK_ISSUER_BASE",
            "key": "keycloak-issuer-base"
          },
          {
            "name": "KEYCLOAK_JWKS_BASE",
            "key": "keycloak-jwks-base"
          },
          {
            "name": "PREDICTIONS_GATES",
            "key": "predictions-gates"
          }
        ]
      }
    }
  ],
  "topics": [
    {
      "name": "markets.events",
      "partitions": 6,
      "retention": "everything"
    },
    {
      "name": "exchange.orders",
      "partitions": 12,
      "retention": "everything"
    },
    {
      "name": "exchange.trades",
      "partitions": 12,
      "retention": "everything"
    },
    {
      "name": "exchange.prices",
      "partitions": 12,
      "retention": "everything"
    }
  ],
  "grants": {
    "made": [
      {
        "principal": "service:reasoner/audit",
        "target": {
          "kind": "topic",
          "topic": "markets.events",
          "right": "consume"
        }
      },
      {
        "principal": "service:reasoner/audit",
        "target": {
          "kind": "topic",
          "topic": "exchange.orders",
          "right": "consume"
        }
      },
      {
        "principal": "service:reasoner/audit",
        "target": {
          "kind": "topic",
          "topic": "exchange.trades",
          "right": "consume"
        }
      },
      {
        "principal": "service:reasoner/audit",
        "target": {
          "kind": "topic",
          "topic": "exchange.prices",
          "right": "consume"
        }
      }
    ],
    "received": []
  },
  "configuration": [
    {
      "key": "casino-project",
      "type": "string",
      "secret": false
    },
    {
      "key": "casino-brand",
      "type": "string",
      "secret": false
    },
    {
      "key": "casino-real-money",
      "type": "boolean",
      "secret": false
    },
    {
      "key": "auth-realm",
      "type": "string",
      "secret": false
    },
    {
      "key": "auth-player-issuer",
      "type": "url",
      "secret": false
    },
    {
      "key": "auth-player-jwks-url",
      "type": "url",
      "secret": false
    },
    {
      "key": "auth-player-audience",
      "type": "string",
      "secret": false
    },
    {
      "key": "auth-staff-issuer",
      "type": "url",
      "secret": false
    },
    {
      "key": "auth-staff-jwks-url",
      "type": "url",
      "secret": false
    },
    {
      "key": "player-site-base",
      "type": "url",
      "secret": false
    },
    {
      "key": "keycloak-issuer-base",
      "type": "url",
      "secret": false
    },
    {
      "key": "keycloak-jwks-base",
      "type": "url",
      "secret": false
    },
    {
      "key": "predictions-categories",
      "type": "string",
      "secret": false
    },
    {
      "key": "predictions-currencies",
      "type": "string",
      "secret": false
    },
    {
      "key": "predictions-max-order-cost",
      "type": "string",
      "secret": false
    },
    {
      "key": "predictions-max-position",
      "type": "string",
      "secret": false
    },
    {
      "key": "predictions-taker-fee-bps",
      "type": "string",
      "secret": false
    },
    {
      "key": "predictions-gates",
      "type": "string",
      "secret": false
    }
  ],
  "retention": "30d"
}
