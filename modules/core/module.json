  ],
  "topics": [
    {
      "name": "money.transactions",
      "partitions": 12,
      "retention": "everything"
    },
    {
      "name": "payments.payments",
      "partitions": 6,
      "retention": "everything"
    },
    {
      "name": "casino.players",
      "partitions": 6,
      "retention": "everything"
    },
    {
      "name": "casino.sessions",
      "partitions": 12,
      "retention": "90d"
    },
    {
      "name": "casino.withdrawals",
      "partitions": 6,
      "retention": "everything"
    },
    {
      "name": "affiliates.attribution",
      "partitions": 6,
      "retention": "everything"
    },
    {
      "name": "platform.audit",
      "partitions": 12,
      "retention": "everything"
    },
    {
      "name": "platform.modules",
      "partitions": 6,
      "retention": "everything"
    }
  ],
  "grants": {
    "made": [
      {
        "principal": "service:payments/merchant",
        "target": {
          "kind": "route",
          "service": "wallet",
          "method": "POST",
          "path": "/v1/casino/brands/{brand}/wallets/{player}/{currency}/deposits"
        }
      },
      {
        "principal": "service:payments/merchant",
        "target": {
          "kind": "route",
          "service": "wallet",
          "method": "POST",
          "path": "/v1/casino/brands/{brand}/payments/{paymentId}/outcome"
        }
      },
      {
        "principal": "service:payments/psp-gateway",
        "target": {
          "kind": "route",
          "service": "payouts",
          "method": "POST",
          "path": "/v1/casino/brands/{brand}/withdrawals/{requestId}/outcome"
        }
      },
      {
        "principal": "service:programme/affiliate-programme",
        "target": {
          "kind": "topic",
          "topic": "affiliates.attribution",
          "right": "consume"
        }
      },
      {
        "principal": "service:reasoner/audit",
        "target": {
          "kind": "topic",
          "topic": "platform.audit",
          "right": "consume"
        }
      },
      {
        "principal": "service:reasoner/audit",
        "target": {
          "kind": "topic",
          "topic": "platform.modules",
          "right": "consume"
        }
      }
    ],
    "received": []
  },
  "configuration": [
    {
      "key": "casino-project",
      "type": "string",
      "secret": false
    },
    {
      "key": "casino-brand",
      "type": "string",
      "secret": false
    },
    {
      "key": "casino-real-money",
      "type": "boolean",
      "secret": false
    },
    {
      "key": "auth-realm",
      "type": "string",
      "secret": false
    },
    {
      "key": "auth-player-issuer",
      "type": "url",
      "secret": false
    },
    {
      "key": "auth-player-jwks-url",
      "type": "url",
      "secret": false
    },
    {
      "key": "auth-player-audience",
      "type": "string",
      "secret": false
    },
    {
      "key": "auth-staff-issuer",
      "type": "url",
      "secret": false
    },
    {
      "key": "auth-staff-jwks-url",
      "type": "url",
      "secret": false
    },
    {
      "key": "player-site-base",
      "type": "url",
      "secret": false
    },
    {
      "key": "keycloak-issuer-base",
      "type": "url",
      "secret": false
    },
    {
      "key": "keycloak-jwks-base",
      "type": "url",
      "secret": false
    },
    {
      "key": "reporting-zone",
      "type": "string",
      "secret": false
    },
    {
      "key": "casino-modules",
      "type": "string",
      "secret": false
    },
    {
      "key": "kyc-max-upload-bytes",
      "type": "string",
      "secret": false
    },
    {
      "key": "ingest-url",
      "type": "url",
      "secret": false
    },
    {
      "key": "players-realm-admin",
      "type": "string",
      "secret": true
    },
    {
      "key": "players-webhook-secret",
      "type": "string",
      "secret": true
    },
    {
      "key": "players-realm-secret",
      "type": "string",
      "secret": true
    },
    {
      "key": "players-email-token",
      "type": "string",
      "secret": true
    },
    {
      "key": "players-lookup-key",
      "type": "string",
      "secret": true
    },
    {
      "key": "players-merchant-key",
      "type": "string",
      "secret": true
    }
  ],
  "requires": [
    {
      "when": {
        "key": "casino-real-money",
        "equals": "true"
      },
      "installation": {
        "backups": {
          "target": "object-store",
          "copyRequired": true,
          "sharesFailureDomain": false
        },
        "erasure": {
          "enabled": true,
          "keyringInstances": 2
        },
        "broker": {
          "nodes": 3,
          "defaultCopies": 3,
          "minInSync": 2
        },
        "topics": {
          "longestRetention": "unbounded"
        }
      }
    }
  ],
  "retention": "30d"
}
