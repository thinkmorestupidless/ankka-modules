{
  "name": "@eitheror/player-sdk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": "./src/index.ts",
    "./core": "./src/core/index.ts",
    "./casino": "./src/casino/index.ts",
    "./engagement": "./src/engagement/index.ts",
    "./support": "./src/support/index.ts",
    "./server": "./src/server/index.ts",
    "./react": "./src/react/index.ts",
    "./testing": "./src/testing/index.ts"
  },
  "scripts": {
    "typecheck": "tsc",
    "test": "vitest run --dir tests --exclude 'tests/features/**' --exclude 'tests/contract/**'",
    "features": "vitest run --dir tests/features",
    "contract": "vitest run --dir tests/contract",
    "lint": "eslint src tests"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.9",
    "hono": "^4.13.19",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "react": "^19.3.1"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@amiceli/vitest-cucumber": "^8.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "jsdom": "^31.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "~5.9",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
}
