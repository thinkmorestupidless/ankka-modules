{
  "project": {
    "id": "payments",
    "name": "Payments"
  },
  "ankka": {
    "runtime": "0.13.0"
  },
  "keycloak": {
    "issuerBase": "https://auth-casino.127.0.0.1.sslip.io:8443"
  },
  "services": [
    {
      "name": "merchant",
      "image": "europe-west1-docker.pkg.dev/eitheror/casino/merchant:0.1.0",
      "expose": true,
      "env": {
        "PAYMENT_DEADLINE": "30m",
        "UNCREDITED_BOUND": "15m",
        "CUSTOMER_RETENTION": "90d",
        "OPERATOR_SYNC_INTERVAL": "60s",
        "KEYCLOAK_URL": "https://auth-casino.127.0.0.1.sslip.io:8443",
        "OPERATORS_REALM": "eitheror",
        "ENGAGEMENT_REGION": "eu",
        "OPERATOR_CONSOLE_URL": "https://payments.127.0.0.1.sslip.io:8443",
        "KEYCLOAK_ADMIN_USERNAME": "secret:keycloak-operators-admin/USERNAME",
        "KEYCLOAK_ADMIN_PASSWORD": "secret:keycloak-operators-admin/PASSWORD"
      }
    },
    {
      "name": "psp-gateway",
      "image": "europe-west1-docker.pkg.dev/eitheror/casino/psp-gateway:0.1.0",
      "expose": true,
      "env": {
        "PUBLIC_URL": "setting:PSP_GATEWAY_PUBLIC_URL",
        "PROVIDER_TIMEOUT": "20s",
        "REDRIVE_INTERVAL": "2m",
        "MERCHANT_SERVICE": "merchant",
        "DREAMZPAY_BASE_URL": "setting:DREAMZPAY_BASE_URL",
        "UNITYFINANCE_PAY_URL": "setting:UNITYFINANCE_PAY_URL",
        "UNITYFINANCE_API_URL": "setting:UNITYFINANCE_API_URL",
        "T365_BASE_URL": "setting:T365_BASE_URL",
        "COZENI_BASE_URL": "setting:COZENI_BASE_URL",
        "EUPAYMENTZ_BASE_URL": "setting:EUPAYMENTZ_BASE_URL",
        "GIGADAT_BASE_URL": "setting:GIGADAT_BASE_URL",
        "BOUNCEMONEY_BASE_URL": "setting:BOUNCEMONEY_BASE_URL",
        "MORPHOSIS_BASE_URL": "setting:MORPHOSIS_BASE_URL",
        "DIGITARIUM_SANDBOX_URL": "setting:DIGITARIUM_SANDBOX_URL",
        "DIGITARIUM_PRODUCTION_URL": "setting:DIGITARIUM_PRODUCTION_URL"
      }
    },
    {
      "name": "ingest",
      "image": "europe-west1-docker.pkg.dev/eitheror/casino/ingest:0.1.0",
      "expose": true,
      "env": {
        "MERCHANT_SERVICE": "merchant",
        "ANSWER_BOUND": "10s",
        "RATE_LIMIT": "600",
        "BODY_BOUND": "65536",
        "REQUEST_ID_BOUND": "128",
        "REQUEST_ID_RETENTION": "24h",
        "RECORD_RETENTION": "90d"
      }
    }
  ],
  "topics": [
    {
      "name": "payments.merchants",
      "partitions": 6,
      "retention": "fact"
    },
    {
      "name": "platform.audit",
      "partitions": 6,
      "retention": "fact"
    }
  ],
  "grants": {
    "made": [
      {
        "principal": "service:{brand}/payouts",
        "target": {
          "route": {
            "service": "psp-gateway",
            "method": "POST",
            "path": "/v1/payments/withdrawals"
          }
        }
      },
      {
        "principal": "service:{brand}/payouts",
        "target": {
          "route": {
            "service": "psp-gateway",
            "method": "GET",
            "path": "/v1/payments/withdrawals/{requestId}"
          }
        }
      },
      {
        "principal": "service:{brand}/payouts",
        "target": {
          "route": {
            "service": "psp-gateway",
            "method": "GET",
            "path": "/v1/payments/withdrawal-terminals"
          }
        }
      },
      {
        "principal": "service:{brand}/players",
        "target": {
          "erasure": true
        }
      }
    ]
  },
  "secrets": [
    {
      "name": "keycloak-operators-admin",
      "keys": [
        "USERNAME",
        "PASSWORD"
      ]
    }
  ]
}
