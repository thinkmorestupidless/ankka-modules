{
  "project": {
    "id": "payments",
    "name": "Payments"
  },
  "ankka": {
    "runtime": "0.11.0"
  },
  "keycloak": {
    "issuerBase": "https://auth-casino.127.0.0.1.sslip.io:8443"
  },
  "services": [
    {
      "name": "merchant",
      "image": "europe-west1-docker.pkg.dev/eitheror/casino/merchant:0.1.0",
      "expose": true,
      "env": {
        "PAYMENT_DEADLINE": "30m",
        "UNCREDITED_BOUND": "15m",
        "CUSTOMER_RETENTION": "90d",
        "OPERATOR_SYNC_INTERVAL": "60s",
        "KEYCLOAK_URL": "https://auth-casino.127.0.0.1.sslip.io:8443",
        "OPERATORS_REALM": "eitheror",
        "ENGAGEMENT_REGION": "eu",
        "OPERATOR_CONSOLE_URL": "https://payments.127.0.0.1.sslip.io:8443",
        "KEYCLOAK_ADMIN_USERNAME": "secret:keycloak-operators-admin/USERNAME",
        "KEYCLOAK_ADMIN_PASSWORD": "secret:keycloak-operators-admin/PASSWORD"
      }
    },
    {
      "name": "psp-gateway",
      "image": "europe-west1-docker.pkg.dev/eitheror/casino/psp-gateway:0.1.0",
      "expose": true
    },
    {
      "name": "ingest",
      "image": "europe-west1-docker.pkg.dev/eitheror/casino/ingest:0.1.0",
      "expose": true
    }
  ],
  "topics": [
    {
      "name": "payments.merchants",
      "partitions": 6,
      "retention": "fact"
    },
    {
      "name": "platform.audit",
      "partitions": 6,
      "retention": "fact"
    }
  ],
  "grants": {
    "made": [
      {
        "principal": "service:{brand}/payouts",
        "target": {
          "route": {
            "service": "psp-gateway",
            "method": "POST",
            "path": "/v1/payments/withdrawals"
          }
        }
      },
      {
        "principal": "service:{brand}/players",
        "target": {
          "erasure": true
        }
      }
    ]
  },
  "secrets": [
    {
      "name": "keycloak-operators-admin",
      "keys": [
        "USERNAME",
        "PASSWORD"
      ]
    }
  ]
}
