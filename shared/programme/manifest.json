{
  "project": {
    "id": "programme",
    "name": "Affiliate programme"
  },
  "ankka": {
    "runtime": "0.13.0"
  },
  "keycloak": {
    "issuerBase": "https://auth-casino.127.0.0.1.sslip.io:8443"
  },
  "services": [
    {
      "name": "affiliate-programme",
      "image": "europe-west1-docker.pkg.dev/eitheror/casino/affiliate-programme:0.1.0",
      "expose": true,
      "resources": {
        "instanceType": "medium"
      },
      "env": {
        "AFFILIATE_PORTAL_BASE_URL": "https://affiliates.127.0.0.1.sslip.io:8443",
        "AFFILIATE_BACKOFFICE_BASE_URL": "https://affiliates-backoffice.127.0.0.1.sslip.io:8443",
        "CUSTOMERIO_REGION_DEFAULT": "eu",
        "PROGRAMME_RETENTION_DAYS": "1825",
        "PUBLIC_URL": "https://affiliate-programme-programme.127.0.0.1.sslip.io:8443",
        "KEYCLOAK_URL": "https://auth-casino.127.0.0.1.sslip.io:8443",
        "KEYCLOAK_REALM": "eitheror",
        "KEYCLOAK_ADMIN_USERNAME": "secret:keycloak-operators-admin/USERNAME",
        "KEYCLOAK_ADMIN_PASSWORD": "secret:keycloak-operators-admin/PASSWORD"
      }
    }
  ],
  "topics": [],
  "grants": {
    "made": []
  },
  "secrets": [
    {
      "name": "keycloak-operators-admin",
      "keys": [
        "USERNAME",
        "PASSWORD"
      ]
    }
  ]
}
