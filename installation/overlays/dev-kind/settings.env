# What this installation is configured to do (spec 001 FR-034 to FR-039). Read by kustomize into the
# casino-installation ConfigMap and by `brands validate --installation dev-kind`. A laptop: no backups,
# no erasure, one broker node, ankka's default retention. It never takes real money.
INSTALLATION=dev-kind
KEYCLOAK_HOSTNAME=auth-casino.127.0.0.1.sslip.io
PLAYER_SITE_BASE=127.0.0.1.sslip.io:8443
KEYCLOAK_ISSUER_BASE=https://auth-casino.127.0.0.1.sslip.io:8443
CLOUD_PROVIDER=none
SECRET_BACKEND=postgres
BACKUP_POINT_IN_TIME=false
BACKUP_OFF_CLUSTER_COPY_REQUIRED=false
ERASURE_ENABLED=false
ERASURE_KEYRING_REPLICAS=0
TOPIC_LONGEST_RETENTION=7d
BROKER_REPLICAS=1
BROKER_MIN_IN_SYNC=1
TOPIC_COPIES=1
OTLP_ENDPOINT=
EDGE_PROTECTION=none
# Where a service reads the casino Keycloak's keys, inside the cluster; tokens still carry KEYCLOAK_ISSUER_BASE.
KEYCLOAK_JWKS_BASE=http://casino-keycloak.casino-identity.svc
# psp-gateway (spec 005 T069): its public address, and every provider at psp-stub (psp-stub.yaml here), by the
# stub's cluster address. The manifest reads these as `setting:<KEY>`; an installation without one leaves the
# gateway refusing that provider by name.
PSP_GATEWAY_PUBLIC_URL=https://psp-gateway-payments.127.0.0.1.sslip.io:8443
DREAMZPAY_BASE_URL=http://psp-stub.casino-stubs.svc:18103
UNITYFINANCE_PAY_URL=http://psp-stub.casino-stubs.svc:18108
UNITYFINANCE_API_URL=http://psp-stub.casino-stubs.svc:18108/v1
T365_BASE_URL=http://psp-stub.casino-stubs.svc:18107
COZENI_BASE_URL=http://psp-stub.casino-stubs.svc:18102
EUPAYMENTZ_BASE_URL=http://psp-stub.casino-stubs.svc:18104
GIGADAT_BASE_URL=http://psp-stub.casino-stubs.svc:18105
BOUNCEMONEY_BASE_URL=http://psp-stub.casino-stubs.svc:18101
MORPHOSIS_BASE_URL=http://psp-stub.casino-stubs.svc:18106
DIGITARIUM_SANDBOX_URL=http://psp-stub.casino-stubs.svc:18109
DIGITARIUM_PRODUCTION_URL=http://psp-stub.casino-stubs.svc:18109
