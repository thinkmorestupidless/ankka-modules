{
  "$id": "https://eitheror.io/schemas/casino/casino.push.v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "The facts on casino.push, produced by engagement (spec 001 FR-011). The family is the body's `type`; `ce-type` is the contract name.",
  "oneOf": [
    {
      "additionalProperties": true,
      "properties": {
        "connections": {
          "type": "integer"
        },
        "correlation_id": {
          "type": "string"
        },
        "occurred_at": {
          "format": "date-time",
          "type": "string"
        },
        "player_id": {
          "type": "string"
        },
        "type": {
          "const": "push_delivered"
        }
      },
      "required": ["type", "player_id", "correlation_id", "connections", "occurred_at"],
      "title": "push_delivered",
      "type": "object"
    },
    {
      "additionalProperties": true,
      "properties": {
        "occurred_at": {
          "format": "date-time",
          "type": "string"
        },
        "online": {
          "type": "boolean"
        },
        "player_id": {
          "type": "string"
        },
        "since": {
          "format": "date-time",
          "type": "string"
        },
        "type": {
          "const": "presence_changed"
        }
      },
      "required": ["type", "player_id", "online", "since", "occurred_at"],
      "title": "presence_changed",
      "type": "object"
    }
  ],
  "title": "casino.push.v1"
}
