{
  "openapi": "3.1.0",
  "info": { "title": "fixture", "version": "0" },
  "paths": {
    "/v1/casino/players/{brand}/wallets/{currency}/balance": {
      "get": {
        "operationId": "get /v1/casino/players/{brand}/wallets/{currency}/balance",
        "summary": "The signed-in player's balance in one currency",
        "tags": ["player"],
        "responses": {
          "200": { "description": "the balance", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Balance" } } } },
          "404": { "description": "no wallet", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Refusal" } } } }
        }
      }
    },
    "/v1/casino/players/{brand}/wallets/{currency}/transactions": {
      "get": {
        "operationId": "get /v1/casino/players/{brand}/wallets/{currency}/transactions",
        "summary": "The signed-in player's transactions",
        "tags": ["player"],
        "responses": { "200": { "description": "a page", "content": { "application/json": { "schema": { "type": "object" } } } } }
      }
    }
  },
  "components": {
    "schemas": {
      "Balance": {
        "type": "object",
        "required": ["realBalance", "currency"],
        "properties": { "realBalance": { "type": "string" }, "currency": { "type": "string" } }
      },
      "Refusal": { "type": "object", "required": ["error"], "properties": { "error": { "type": "string" } } }
    }
  }
}
