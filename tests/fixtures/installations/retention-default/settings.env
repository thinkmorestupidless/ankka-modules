# eitheror's GKE installation (spec 001 FR-034 to FR-039, research R9). Read by kustomize into the
# casino-installation ConfigMap and by `brands validate --installation gke --real-money`. Values that
# are secrets are never here: the Keycloak administrator, the cloud credentials and the ST8 and PSP
# credentials are created out of band. Every setting below is what ankka must be installed with; the
# platform's own overlay (ankka kustomization/overlays/cloud) carries the same values.
INSTALLATION=retention-default
KEYCLOAK_HOSTNAME=auth-casino.eitheror.io
KEYCLOAK_ISSUER_BASE=https://auth-casino.eitheror.io
PLAYER_SITE_BASE=eitheror.io
# ankka 044 / 038 / 039: Google, Secret Manager, Cloud Storage
CLOUD_PROVIDER=gcp
CLOUD_ACCOUNT=eitheror-prod
CLOUD_LOCATION=europe-west1
SECRET_BACKEND=secret-manager
OBJECT_STORE=gcs
# ankka 041: point-in-time recovery, with a copy outside the cluster required
BACKUP_POINT_IN_TIME=true
BACKUP_OFF_CLUSTER_COPY_REQUIRED=true
# ankka 042: erasure on, the keyring at two instances (FR-036)
ERASURE_ENABLED=true
ERASURE_KEYRING_REPLICAS=2
# ankka 043: facts may be kept for ever; three copies, two in sync, on three broker nodes from creation
TOPIC_LONGEST_RETENTION=7d
BROKER_REPLICAS=3
BROKER_MIN_IN_SYNC=2
TOPIC_COPIES=3
# ankka 026: telemetry to the existing Grafana stack (Alloy's OTLP receiver)
OTLP_ENDPOINT=http://alloy.observability.svc.cluster.local:4317
# Cloud Armor in front of the gateway (FR-034): ankka's gateway does no rate limiting
EDGE_PROTECTION=cloud-armor:casino-edge-policy
