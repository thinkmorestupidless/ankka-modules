+	rkRequireStatus(t, http.StatusOK, rkPlayerBreak(t, s, p, rkBreakUntil()), "PUT cooling-off")
+
+	// The player's cooling-off route is PUT only: a DELETE is refused as a method not allowed.
+	end := rkDo(t, http.MethodDelete, rkRgURL(s, p, "/cooling-off"), p.token, nil, nil)
+	rkRequireStatus(t, http.StatusMethodNotAllowed, end, "player DELETE cooling-off")
+	require.True(t, rkGetRg(t, s, p).IsCoolingOff, "the break still applies")
+
+	t.Run("shortening the break is refused", func(t *testing.T) {
+		t.Skip("original defect: the player's PUT cooling-off accepts any until, earlier or past, so a break can be " +
+			"shortened (spec 010 Changes from the original: a break has bounds; today any until is accepted)")
+	})
