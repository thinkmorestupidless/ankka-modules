+// features/kyc/gates.feature
+// Scenario Outline: play is allowed for a verified player or on a brand whose play gate is none
+//
+// "Allowed" is asserted as the launch not being refused by the KYC gate: past the gate, the
+// launch goes on to resolve the brand's ST8 credentials, whose answer depends on the cluster.
+func TestScenario29_KYCGates_PlayAllowedForVerifiedOrGateNone(t *testing.T) {
+	setup.SkipIfMissing(t)
+	s := setup.New()
+	op := rkOperatorToken(t, s)
+	rkPolicyGuard(t, s, op)
+
+	requireNotKycRefused := func(t *testing.T, r rkResult) {
+		t.Helper()
+		require.NotEqual(t, "PLAY_BLOCKED_KYC", r.body["error"], "the KYC gate must not refuse: %d %s", r.status, r.raw)
+		require.NotEqual(t, "account_restricted", r.body["error"], "nothing restricts this player: %d %s", r.status, r.raw)
+		t.Logf("scenario29: launch past the KYC gate answered %d %s", r.status, r.raw)
+	}
+
+	t.Run("the brand's play gate is verified and the player is verified", func(t *testing.T) {
+		rkRequireStatus(t, http.StatusOK, rkApplyProfile(t, s, op, "ukgc"), "apply ukgc")
+		p := rkNewPlayer(t, s)
+		rkOverrideVerified(t, s, p, op)
+		requireNotKycRefused(t, rkLaunch(t, s, p))
+	})
+
+	t.Run("the brand's play gate is none and the player is unverified", func(t *testing.T) {
+		rkRequireStatus(t, http.StatusOK, rkApplyProfile(t, s, op, "curacao"), "apply curacao")
+		p := rkNewPlayer(t, s)
+		requireNotKycRefused(t, rkLaunch(t, s, p))
+	})
+}
