+//go:build e2e
+
+// Scenario 28 — KYC: a player's documents, an operator's review, and the account's KYC status.
+//
+// Drives (all under /v1/casino/{brandId}/players/{playerId}/kyc, BackofficePlayerRoutes):
+//
+//	POST  /upload-url                         player JWT — presigned PUT (MinIO)
+//	GET   /documents, POST /documents         player JWT — list; confirm an upload
+//	GET   /documents/{docKey}/view-url        player or operator JWT — presigned GET
+//	PATCH /documents/{docKey}/approve|reject  operator JWT (brand_admin, brand_compliance, ...)
+//	PUT   /verification-mode, /status, /required-doc-types; PATCH /verify, /reject   operator JWT
+//
+// plus PATCH /v1/casino/backoffice/{brandId}/players/{playerId}/profile (PlayerProfileRoutes) to
+// complete a profile, and the brand's KYC policy (scenario 29 helpers) to fix the required
+// categories. The account's KYC status in automatic mode is derived by the kyc-status-rollup TL
+// function off kyc_documents_updated_at (just kind-register-casino-functions), so those tests
+// poll the player's documents read for it.
+//
+// Confirming an upload records metadata only; the tests confirm keys under the player's prefix
+// without uploading bytes, as the original's Playwright suite 33 does.
+//
+// Requires EITHEROR_CASINO_URL, EITHEROR_SUBSTRATE_URL (the view-log read), MinIO configured on
+// casino-service (upload and view addresses), and TEST_OPERATOR_EMAIL / TEST_OPERATOR_PASSWORD
+// for every review test.
+package e2e_test
+
+import (
+	"encoding/json"
+	"fmt"
+	"net/http"
+	"net/url"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/google/uuid"
+	"github.com/stretchr/testify/require"
+
+	"github.com/eitheror-io/eitheror-platform/tests/e2e/internal/setup"
+	"github.com/eitheror-io/eitheror-platform/tests/e2e/internal/wait"
+)
+
+// rkKycDocs is the player's GET .../kyc/documents answer.
+type rkKycDocs struct {
+	Documents        []map[string]any `json:"documents"`
+	RequiredDocTypes []string         `json:"requiredDocTypes"`
+	KycStatus        string           `json:"kycStatus"`
+}
+
+func rkGetKycDocs(t *testing.T, s setup.Suite, p rkPlayer) rkKycDocs {
+	t.Helper()
+	r := rkDo(t, http.MethodGet, rkPlayerURL(s, p, "/kyc/documents"), p.token, nil, nil)
+	rkRequireStatus(t, http.StatusOK, r, "player GET kyc/documents")
+	var d rkKycDocs
+	require.NoError(t, json.Unmarshal([]byte(r.raw), &d), "decode kyc/documents: %s", r.raw)
+	return d
+}
+
+// rkDoc returns the document with key.
+func (d rkKycDocs) doc(key string) (map[string]any, bool) {
+	for _, doc := range d.Documents {
+		if doc["key"] == key {
+			return doc, true
+		}
+	}
+	return nil, false
+}
+
+// rkConfirmDocResult confirms a document of docType under the player's own prefix and returns the
+// key and the answer.
+func rkConfirmDocResult(t *testing.T, s setup.Suite, p rkPlayer, docType string) (string, rkResult) {
+	t.Helper()
+	key := fmt.Sprintf("%s/%s/%s-e2e-%s.jpg", p.brandId, p.playerId, docType, uuid.New().String()[:8])
+	r := rkDo(t, http.MethodPost, rkPlayerURL(s, p, "/kyc/documents"), p.token,
+		map[string]string{"key": key, "docType": docType}, nil)
+	return key, r
+}
+
+// rkConfirmDoc confirms a document and requires it recorded.
+func rkConfirmDoc(t *testing.T, s setup.Suite, p rkPlayer, docType string) string {
+	t.Helper()
+	key, r := rkConfirmDocResult(t, s, p, docType)
+	rkRequireStatus(t, http.StatusOK, r, "player POST kyc/documents "+docType)
+	require.Equal(t, "recorded", r.body["status"], "body: %s", r.raw)
+	return key
+}
+
+// rkDocURL is the per-document route; the key is a path segment, so its slashes are encoded.
+func rkDocURL(s setup.Suite, p rkPlayer, key, action string) string {
+	return rkPlayerURL(s, p, "/kyc/documents/"+url.PathEscape(key)+"/"+action)
+}
+
+func rkApproveDoc(t *testing.T, s setup.Suite, p rkPlayer, op, key string) rkResult {
+	t.Helper()
+	return rkDo(t, http.MethodPatch, rkDocURL(s, p, key, "approve"), op, nil, nil)
+}
+
+func rkRejectDoc(t *testing.T, s setup.Suite, p rkPlayer, op, key, reason string) rkResult {
+	t.Helper()
+	return rkDo(t, http.MethodPatch, rkDocURL(s, p, key, "reject"), op, map[string]string{"reason": reason}, nil)
+}
+
+// rkWaitKycStatus polls the player's documents read until the account's KYC status is want.
+func rkWaitKycStatus(t *testing.T, s setup.Suite, p rkPlayer, want string, timeout time.Duration) {
+	t.Helper()
+	last := ""
+	wait.WaitUntil(t, func() (bool, error) {
+		last = rkGetKycDocs(t, s, p).KycStatus
+		return last == want, nil
+	}, timeout, fmt.Sprintf("KYC status of %s should become %q (kyc-status-rollup)", p.playerId, want))
+}
+
+// rkRequireKycStatusNever asserts the KYC status does not become unwanted for d.
+func rkRequireKycStatusNever(t *testing.T, s setup.Suite, p rkPlayer, unwanted string, d time.Duration) {
+	t.Helper()
+	wait.WithinDuration(t, func() (bool, error) {
+		return rkGetKycDocs(t, s, p).KycStatus == unwanted, nil
+	}, d, fmt.Sprintf("KYC status of %s must not become %q", p.playerId, unwanted))
+}
+
+// rkCompleteProfile fills the profile fields a fresh registration lacks (phone and address), as an
+// operator; registration already carries names, date of birth and country.
+func rkCompleteProfile(t *testing.T, s setup.Suite, p rkPlayer, op string) {
+	t.Helper()
+	r := rkDo(t, http.MethodPatch,
+		fmt.Sprintf("%s/v1/casino/backoffice/%s/players/%s/profile", s.CasinoURL, p.brandId, p.playerId), op,
+		map[string]string{
+			"phone":        "+447700900123",
+			"addressLine1": "1 E2E Street",
+			"city":         "London",
+			"postalCode":   "E1 6AN",
+		}, nil)
+	rkRequireStatus(t, http.StatusOK, r, "operator PATCH profile")
+}
+
+// rkTwinProps reads the player twin from the substrate.
+func rkTwinProps(t *testing.T, s setup.Suite, p rkPlayer) map[string]any {
+	t.Helper()
+	props, err := s18GetTwinProps(s, "casino-"+p.brandId, p.playerId)
+	require.NoError(t, err)
+	return props
+}
