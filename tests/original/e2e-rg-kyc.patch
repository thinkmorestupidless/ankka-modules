+// rkRgStatus is the RgStatus JSON RgRoutes answers (and, with fewer fields, the operator route).
+type rkRgStatus struct {
+	Limits []struct {
+		LimitType string  `json:"limitType"`
+		Value     float64 `json:"value"`
+	} `json:"limits"`
+	PendingChanges []rkPending `json:"pendingChanges"`
+	UsedAmounts    []struct {
+		LimitType  string  `json:"limitType"`
+		UsedAmount float64 `json:"usedAmount"`
+	} `json:"usedAmounts"`
+	CoolingOffUntil    *string  `json:"coolingOffUntil"`
+	IsCoolingOff       bool     `json:"isCoolingOff"`
+	ActiveRestrictions []string `json:"activeRestrictions"`
+}
+
+type rkPending struct {
+	LimitType    string  `json:"limitType"`
+	PendingValue *string `json:"pendingValue"`
+	AppliesAt    string  `json:"appliesAt"`
+}
+
+func rkDecodeRg(t *testing.T, r rkResult) rkRgStatus {
+	t.Helper()
+	var st rkRgStatus
+	require.NoError(t, json.Unmarshal([]byte(r.raw), &st), "decode RgStatus: %s", r.raw)
+	return st
+}
+
+func (st rkRgStatus) limit(limitType string) (float64, bool) {
+	for _, l := range st.Limits {
+		if l.LimitType == limitType {
+			return l.Value, true
+		}
+	}
+	return 0, false
+}
+
+func (st rkRgStatus) pending(limitType string) (rkPending, bool) {
+	for _, p := range st.PendingChanges {
+		if p.LimitType == limitType {
+			return p, true
+		}
+	}
+	return rkPending{}, false
+}
+
+func (st rkRgStatus) used(limitType string) (float64, bool) {
+	for _, u := range st.UsedAmounts {
+		if u.LimitType == limitType {
+			return u.UsedAmount, true
+		}
+	}
+	return 0, false
+}
+
+// rkRequireAppliesAt asserts a pending change's appliesAt is 24 hours after the request, within
+// a couple of minutes either way for clock skew between the test host and the cluster.
+func rkRequireAppliesAt(t *testing.T, appliesAt string, before, after time.Time) time.Time {
+	t.Helper()
+	at, err := time.Parse(time.RFC3339, appliesAt)
+	require.NoError(t, err, "appliesAt %q should be an ISO-8601 instant", appliesAt)
+	slack := 2 * time.Minute
+	require.True(t, !at.Before(before.Add(24*time.Hour-slack)) && !at.After(after.Add(24*time.Hour+slack)),
+		"appliesAt %s should be 24 hours after the change (between %s and %s)",
+		at, before.Add(24*time.Hour), after.Add(24*time.Hour))
+	return at
+}
+
+// rkRequireLimit asserts a limit type applies with the given value.
+func rkRequireLimit(t *testing.T, st rkRgStatus, limitType string, want float64) {
+	t.Helper()
+	v, ok := st.limit(limitType)
+	require.True(t, ok, "%s should apply, limits: %+v", limitType, st.Limits)
+	require.InDelta(t, want, v, 0.001, "%s should be %v", limitType, want)
+}
