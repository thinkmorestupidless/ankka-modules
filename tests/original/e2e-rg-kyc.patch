+// features/kyc/policy.feature
+// Scenario: an unauthenticated client asking the brand's requirements is told the required categories and nothing else
+func TestScenario29_KYCPolicy_UnauthenticatedRequirementsRead(t *testing.T) {
+	setup.SkipIfMissing(t)
+	s := setup.New()
+
+	r := rkDo(t, http.MethodGet, fmt.Sprintf("%s/v1/casino/players/%s/kyc/requirements", s.CasinoURL, setup.CasinoBrandID()), "", nil, nil)
+	rkRequireStatus(t, http.StatusOK, r, "GET kyc/requirements")
