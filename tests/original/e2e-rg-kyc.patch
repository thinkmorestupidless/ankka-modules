+// features/kyc/gates.feature
+// Scenario Outline: a brand whose deposit gate is verified refuses a deposit by an unverified, pending or rejected player with the status's own words
+func TestScenario29_KYCGates_DepositGateRefusesUnverifiedPendingRejected(t *testing.T) {
+	setup.SkipIfMissing(t)
+	s := setup.New()
+	op := rkOperatorToken(t, s)
+	rkPolicyGuard(t, s, op)
+	rkRequireStatus(t, http.StatusOK, rkApplyProfile(t, s, op, "ukgc"), "apply ukgc (deposit gate verified)")
+
+	for _, tc := range []struct {
+		status string
+		words  string
+		set    func(t *testing.T, p rkPlayer)
+	}{
+		{"unverified", "Please verify your identity before depositing", func(t *testing.T, p rkPlayer) {}},
+		{"pending", "Your identity documents are under review", func(t *testing.T, p rkPlayer) {
+			r := rkDo(t, http.MethodPut, rkPlayerURL(s, p, "/kyc/status"), op, map[string]string{"status": "pending"}, nil)
+			rkRequireStatus(t, http.StatusOK, r, "PUT kyc/status pending")
+		}},
+		{"rejected", "Your identity documents were not accepted — please re-submit", func(t *testing.T, p rkPlayer) {
+			r := rkDo(t, http.MethodPatch, rkPlayerURL(s, p, "/kyc/reject"), op, map[string]string{"reason": "e2e"}, nil)
+			rkRequireStatus(t, http.StatusOK, r, "PATCH kyc/reject")
+		}},
+	} {
+		tc := tc
+		t.Run(tc.status, func(t *testing.T) {
+			p := rkNewPlayer(t, s)
+			tc.set(t, p)
+			r := rkNotifyDeposit(t, s, p, "10")
+			rkRequireStatus(t, http.StatusForbidden, r, "notify deposit")
+			require.Equal(t, "DEPOSIT_BLOCKED_KYC", r.body["error"], "body: %s", r.raw)
+			require.Equal(t, tc.status, r.body["kycStatus"], "body: %s", r.raw)
+			require.Equal(t, tc.words, r.body["message"], "body: %s", r.raw)
+		})
+	}
+}
