+// features/responsible-gambling/limits.feature
+// Scenario: a first daily deposit limit applies at once and shows with the amount used in the last day
+func TestScenario26_RGLimits_FirstDailyDepositLimitAppliesAtOnce(t *testing.T) {
+	setup.SkipIfMissing(t)
+	s := setup.New()
+	p := rkNewPlayer(t, s)
+
+	res := rkSetLimit(t, s, p, "DEPOSIT_DAILY", "100")
+	rkRequireStatus(t, http.StatusOK, res, "PUT limits/DEPOSIT_DAILY")
+	st := rkDecodeRg(t, res)
+	rkRequireLimit(t, st, "DEPOSIT_DAILY", 100)
+	_, pending := st.pending("DEPOSIT_DAILY")
+	require.False(t, pending, "a first limit is more restrictive than none and must not be staged: %s", res.raw)
+
+	read := rkGetRg(t, s, p)
+	rkRequireLimit(t, read, "DEPOSIT_DAILY", 100)
+	used, ok := read.used("DEPOSIT_DAILY")
+	require.True(t, ok, "usedAmounts should carry DEPOSIT_DAILY (the last 24 hours' deposits)")
+	require.InDelta(t, 0, used, 0.001, "a fresh player has deposited nothing in the last 24 hours")
+}
