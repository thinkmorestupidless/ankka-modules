+// ---------------------------------------------------------------------------
+// breaks.feature — A player takes a break or excludes themselves, and an operator does the same
+// ---------------------------------------------------------------------------
+
+// features/responsible-gambling/breaks.feature
+// Scenario: a break set by the player applies at once, opens a case with its end and publishes one case opened fact
+//
+// The case is the original's RGCase twin, seen through the history read; the original publishes
+// no fact.
+func TestScenario27_RGBreaks_PlayerBreakAppliesAtOnceAndOpensCase(t *testing.T) {
+	setup.SkipIfMissing(t)
+	s := setup.New()
+	p := rkNewPlayer(t, s)
+
+	until := rkBreakUntil()
+	res := rkPlayerBreak(t, s, p, until)
+	rkRequireStatus(t, http.StatusOK, res, "PUT cooling-off")
+	st := rkDecodeRg(t, res)
+	require.True(t, st.IsCoolingOff, "the break applies at once: %s", res.raw)
+	require.NotNil(t, st.CoolingOffUntil)
+	require.Equal(t, until, *st.CoolingOffUntil)
+	require.Contains(t, st.ActiveRestrictions, "COOLING_OFF")
+
+	wait.WaitUntil(t, func() (bool, error) {
+		return rkHistoryHas(t, s, p, "cooling_off_applied", "player")
+	}, 15*time.Second, "the RG history should show the player's cooling-off case")
+}
