+// rkResult is one HTTP answer: status, raw body, and the body decoded as an object when it is one.
+type rkResult struct {
+	status int
+	raw    string
+	body   map[string]any
+}
+
+// rkDo sends a request with an optional JSON body, bearer token and extra headers.
+func rkDo(t *testing.T, method, fullURL, token string, body any, headers map[string]string) rkResult {
+	t.Helper()
+	var reader io.Reader
+	if body != nil {
+		b, err := json.Marshal(body)
+		require.NoError(t, err)
+		reader = bytes.NewReader(b)
+	}
+	req, err := http.NewRequest(method, fullURL, reader)
+	require.NoError(t, err, "build %s %s", method, fullURL)
+	if body != nil {
+		req.Header.Set("Content-Type", "application/json")
+	}
+	if token != "" {
+		req.Header.Set("Authorization", "Bearer "+token)
+	}
+	for k, v := range headers {
+		req.Header.Set(k, v)
+	}
+	resp, err := http.DefaultClient.Do(req)
+	require.NoError(t, err, "%s %s", method, fullURL)
+	defer resp.Body.Close()
+	raw, err := io.ReadAll(resp.Body)
+	require.NoError(t, err)
+	var parsed map[string]any
+	_ = json.Unmarshal(raw, &parsed)
+	return rkResult{status: resp.StatusCode, raw: string(raw), body: parsed}
+}
+
+// rkRequireStatus asserts the status code, printing the body on failure.
+func rkRequireStatus(t *testing.T, want int, r rkResult, what string) {
+	t.Helper()
+	require.Equal(t, want, r.status, "%s: expected %d, body: %s", what, want, r.raw)
+}
+
+// rkPlayer is a freshly registered, signed-in casino player of the suite's casino brand.
+type rkPlayer struct {
+	brandId  string
+	playerId string
+	token    string
+	email    string
+	password string
+}
+
+// rkNewPlayer registers a player with a run-unique identity (no SUSPECTED_DUPLICATE on a shared
+// KinD), clears email verification and signs in — the same path scenarios 19 and FreeSpinsPlay use.
+func rkNewPlayer(t *testing.T, s setup.Suite) rkPlayer {
+	t.Helper()
+	brandId := setup.CasinoBrandID()
+	runId := uuid.New().String()[:8]
+	playerId := s14RegisterPlayerWithIdentity(t, s, brandId, runId)
+	token := s19LoginAndGetToken(t, s, brandId, runId)
+	return rkPlayer{
+		brandId:  brandId,
+		playerId: playerId,
+		token:    token,
+		email:    fmt.Sprintf("e2e-%s@example.com", runId),
+		password: fmt.Sprintf("E2e-%s!Pwd", runId),
+	}
+}
+
+// rkOperatorToken returns an operator JWT or skips the test when the operator credentials are absent.
+func rkOperatorToken(t *testing.T, s setup.Suite) string {
+	t.Helper()
+	token := s18GetOperatorToken(t, s)
+	if token == "" {
+		t.Skip("TEST_OPERATOR_EMAIL / TEST_OPERATOR_PASSWORD not set — skipping operator-driven scenario")
+	}
+	return token
+}
+
+// rkRgURL is the player RG route: /v1/casino/rg/{brandId}/{playerId}{suffix}.
+func rkRgURL(s setup.Suite, p rkPlayer, suffix string) string {
+	return fmt.Sprintf("%s/v1/casino/rg/%s/%s%s", s.CasinoURL, p.brandId, p.playerId, suffix)
+}
+
+// rkPlayerURL is the per-player route under the brand: /v1/casino/{brandId}/players/{playerId}{suffix}
+// (operator RG, self-exclude, reinstate, and both the player and operator KYC routes).
+func rkPlayerURL(s setup.Suite, p rkPlayer, suffix string) string {
+	return fmt.Sprintf("%s/v1/casino/%s/players/%s%s", s.CasinoURL, p.brandId, p.playerId, suffix)
+}
+
+// rkSetLimit is the player's PUT .../limits/{type} with {"value": value}.
+func rkSetLimit(t *testing.T, s setup.Suite, p rkPlayer, limitType, value string) rkResult {
+	t.Helper()
+	return rkDo(t, http.MethodPut, rkRgURL(s, p, "/limits/"+limitType), p.token, map[string]string{"value": value}, nil)
+}
+
+// rkGetRg is the player's GET .../limits (the RgStatus read).
+func rkGetRg(t *testing.T, s setup.Suite, p rkPlayer) rkRgStatus {
+	t.Helper()
+	r := rkDo(t, http.MethodGet, rkRgURL(s, p, "/limits"), p.token, nil, nil)
+	rkRequireStatus(t, http.StatusOK, r, "GET rg limits")
+	return rkDecodeRg(t, r)
+}
+
+// rkLogin posts the player's credentials to /v1/casino/players/{brandId}/login and returns the
+// answer without asserting it.
+func rkLogin(t *testing.T, s setup.Suite, p rkPlayer) rkResult {
+	t.Helper()
+	return rkDo(t, http.MethodPost, fmt.Sprintf("%s/v1/casino/players/%s/login", s.CasinoURL, p.brandId), "",
+		map[string]string{"email": p.email, "password": p.password}, nil)
+}
+
+// rkLaunch asks casino-service to open a game session (POST /v1/casino/sessions/{brandId}/launch).
+// The RG and KYC preflight runs before the game id is resolved, so a probe game id suffices for
+// refusals.
+func rkLaunch(t *testing.T, s setup.Suite, p rkPlayer) rkResult {
+	t.Helper()
+	return rkDo(t, http.MethodPost, fmt.Sprintf("%s/v1/casino/sessions/%s/launch", s.CasinoURL, p.brandId), p.token,
+		map[string]any{"playerId": p.playerId, "gameId": "e2e-rk-probe", "currency": "EUR"}, nil)
+}
+
+// rkNotifyDeposit calls the internal deposit notification casino-service runs its deposit
+// preflight on (POST /internal/v1/casino/{brandId}/notify/deposit on the casino-service NodePort,
+// X-Internal-Secret). In the original this route is called by deposit-on-payment-capture-fn after
+// the wallet has credited; its 403 is the refusal the port moves before the credit.
+func rkNotifyDeposit(t *testing.T, s setup.Suite, p rkPlayer, amount string) rkResult {
+	t.Helper()
+	return rkDo(t, http.MethodPost,
+		fmt.Sprintf("%s/internal/v1/casino/%s/notify/deposit", s.CasinoInternalURL, p.brandId), "",
+		map[string]string{
+			"playerId":      p.playerId,
+			"amount":        amount,
+			"currency":      "EUR",
+			"transactionId": "e2e-rk-" + uuid.New().String(),
+		},
+		map[string]string{"X-Internal-Secret": setup.WalletInternalSecret()})
+}
