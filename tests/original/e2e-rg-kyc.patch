+
+	for _, ct := range []struct{ contentType, ext string }{
+		{"image/jpeg", "jpg"}, {"image/png", "png"}, {"application/pdf", "pdf"},
+	} {
+		ct := ct
+		t.Run(ct.contentType, func(t *testing.T) {
+			r := rkDo(t, http.MethodPost, rkPlayerURL(s, p, "/kyc/upload-url"), p.token,
+				map[string]string{"docType": "identity_front", "contentType": ct.contentType}, nil)
+			rkRequireStatus(t, http.StatusOK, r, "player POST kyc/upload-url (needs MinIO configured)")
+			uploadURL, _ := r.body["url"].(string)
+			key, _ := r.body["key"].(string)
+			require.Contains(t, uploadURL, "X-Amz-Expires=3600", "the upload address is valid for an hour: %s", r.raw)
+			require.True(t, strings.HasPrefix(key, p.brandId+"/"+p.playerId+"/identity_front-"),
+				"the document id (key) lies under the player's own prefix: %s", key)
+			require.True(t, strings.HasSuffix(key, "."+ct.ext), "key %s should end .%s", key, ct.ext)
+			require.Equal(t, ct.contentType, r.body["contentType"], "body: %s", r.raw)
+		})
+	}
+}
