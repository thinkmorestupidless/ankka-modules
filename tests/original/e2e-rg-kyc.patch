+// features/responsible-gambling/limits.feature
+// Scenario: lowering a deposit limit applies at once and cancels any pending change for it
+func TestScenario26_RGLimits_LoweringAppliesAtOnceAndCancelsPending(t *testing.T) {
+	setup.SkipIfMissing(t)
+	s := setup.New()
+	p := rkNewPlayer(t, s)
+
+	rkRequireStatus(t, http.StatusOK, rkSetLimit(t, s, p, "DEPOSIT_DAILY", "100"), "set 100")
+	raise := rkSetLimit(t, s, p, "DEPOSIT_DAILY", "200")
+	rkRequireStatus(t, http.StatusOK, raise, "raise to 200")
+	_, pending := rkDecodeRg(t, raise).pending("DEPOSIT_DAILY")
+	require.True(t, pending, "the raise should be pending before the lowering: %s", raise.raw)
+
+	lower := rkSetLimit(t, s, p, "DEPOSIT_DAILY", "50")
+	rkRequireStatus(t, http.StatusOK, lower, "lower to 50")
+	st := rkDecodeRg(t, lower)
+	rkRequireLimit(t, st, "DEPOSIT_DAILY", 50)
+	_, pending = st.pending("DEPOSIT_DAILY")
+	require.False(t, pending, "lowering must cancel the pending raise: %s", lower.raw)
+}
