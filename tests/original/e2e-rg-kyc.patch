+//go:build e2e
+
+// Scenario 29 — KYC: the brand's KYC policy and the gates it puts on deposits and play.
+//
+// Drives:
+//
+//	GET/PUT /v1/casino/backoffice/{brandId}/kyc-policy           (BackofficeKycPolicyRoutes, operator JWT)
+//	POST    /v1/casino/backoffice/{brandId}/kyc-policy/profile   (BackofficeKycPolicyRoutes, operator JWT)
+//	GET     /v1/casino/players/{brandId}/kyc/requirements        (PlayerRoutes, no auth)
+//	POST    /v1/casino/backoffice/{brandId}/{playerId}/kyc/approve (manual KYC override, operator JWT)
+//	PUT     /v1/casino/{brandId}/players/{playerId}/kyc/status, PATCH .../kyc/reject (operator JWT)
+//	POST    /internal/v1/casino/{brandId}/notify/deposit         (the deposit gate, X-Internal-Secret)
+//	POST    /v1/casino/sessions/{brandId}/launch                 (the play gate, player JWT)
+//
+// The policy is the brand's, shared by every test on the brand: each test that changes it
+// snapshots it first and restores it on cleanup (rkPolicyGuard). Go runs these tests one at a time
+// unless a test calls t.Parallel, which none here does.
+//
+// Requires EITHEROR_CASINO_URL, EITHEROR_CASINO_INTERNAL_URL and TEST_OPERATOR_EMAIL /
+// TEST_OPERATOR_PASSWORD (an operator with brand_admin on the casino brand).
+package e2e_test
+
+import (
+	"fmt"
+	"net/http"
+	"testing"
+
+	"github.com/google/uuid"
+	"github.com/stretchr/testify/require"
+
+	"github.com/eitheror-io/eitheror-platform/tests/e2e/internal/setup"
+)
+
+// ---------------------------------------------------------------------------
+// Policy helpers (also used by scenarios 27 and 28)
+// ---------------------------------------------------------------------------
+
+func rkPolicyURL(s setup.Suite, suffix string) string {
+	return fmt.Sprintf("%s/v1/casino/backoffice/%s/kyc-policy%s", s.CasinoURL, setup.CasinoBrandID(), suffix)
+}
+
+func rkGetPolicy(t *testing.T, s setup.Suite, op string) rkResult {
+	t.Helper()
+	return rkDo(t, http.MethodGet, rkPolicyURL(s, ""), op, nil, nil)
+}
+
+func rkPutPolicy(t *testing.T, s setup.Suite, op string, fields map[string]any) rkResult {
+	t.Helper()
+	return rkDo(t, http.MethodPut, rkPolicyURL(s, ""), op, fields, nil)
+}
+
+func rkApplyProfile(t *testing.T, s setup.Suite, op, profile string) rkResult {
+	t.Helper()
+	return rkDo(t, http.MethodPost, rkPolicyURL(s, "/profile"), op, map[string]string{"profile": profile}, nil)
+}
+
+// rkPolicyGuard snapshots the brand's KYC policy and restores it when the test ends. The PUT
+// treats a JSON null as "no value" for the three optional fields, so an absent field restores as
+// absent.
+func rkPolicyGuard(t *testing.T, s setup.Suite, op string) {
+	t.Helper()
+	snap := rkGetPolicy(t, s, op)
+	rkRequireStatus(t, http.StatusOK, snap, "GET kyc-policy (snapshot)")
+	restore := map[string]any{}
+	for _, k := range []string{
+		"depositGate", "playGate", "requiredDocTypes", "autoSuspendOnWindowExpiry", "licenceProfile",
+		"depositThresholdMinorUnits", "kycWindowDays", "sofThresholdMinorUnits",
+	} {
+		restore[k] = snap.body[k] // absent → nil → null
+	}
+	t.Cleanup(func() {
+		r := rkPutPolicy(t, s, op, restore)
+		if r.status != http.StatusOK {
+			t.Errorf("restoring the brand's KYC policy failed: %d %s (snapshot was %s)", r.status, r.raw, snap.raw)
+		}
+	})
+}
+
+// rkEnsureNoKycGates makes sure the brand's KYC policy neither gates nor thresholds deposits and
+// play, so an RG refusal is not pre-empted by a KYC one (the original checks KYC first). With no
+// operator credentials the policy cannot be read and the brand's own is used as it stands.
+func rkEnsureNoKycGates(t *testing.T, s setup.Suite) {
+	t.Helper()
+	op := s18GetOperatorToken(t, s)
+	if op == "" {
+		t.Logf("no operator credentials: assuming the brand's KYC policy has no deposit or play gate")
+		return
+	}
+	pol := rkGetPolicy(t, s, op)
+	rkRequireStatus(t, http.StatusOK, pol, "GET kyc-policy")
+	_, depThreshold := pol.body["depositThresholdMinorUnits"]
+	_, sofThreshold := pol.body["sofThresholdMinorUnits"]
+	if pol.body["depositGate"] == "NONE" && pol.body["playGate"] == "NONE" && !depThreshold && !sofThreshold {
+		return
+	}
+	rkPolicyGuard(t, s, op)
+	rkRequireStatus(t, http.StatusOK, rkApplyProfile(t, s, op, "curacao"), "apply the curacao profile")
+}
+
+// rkOverrideVerified verifies a player with the operator's manual KYC override.
+func rkOverrideVerified(t *testing.T, s setup.Suite, p rkPlayer, op string) {
+	t.Helper()
+	r := rkDo(t, http.MethodPost,
+		fmt.Sprintf("%s/v1/casino/backoffice/%s/%s/kyc/approve", s.CasinoURL, p.brandId, p.playerId), op,
+		map[string]string{"reason": "e2e: verified for a gate test"}, nil)
+	rkRequireStatus(t, http.StatusOK, r, "POST backoffice kyc/approve")
+	require.Equal(t, "verified", r.body["kycStatus"], "body: %s", r.raw)
+}
+
+// rkRequirePolicy asserts the policy fields a profile sets. A nil threshold or window means absent.
+func rkRequirePolicy(t *testing.T, r rkResult, depositGate, playGate string, depositThreshold, windowDays, sofThreshold any,
+	required []string, suspend bool, profile string) {
+	t.Helper()
+	b := r.body
+	require.Equal(t, depositGate, b["depositGate"], "depositGate: %s", r.raw)
+	require.Equal(t, playGate, b["playGate"], "playGate: %s", r.raw)
+	for field, want := range map[string]any{
+		"depositThresholdMinorUnits": depositThreshold,
+		"kycWindowDays":              windowDays,
+		"sofThresholdMinorUnits":     sofThreshold,
+	} {
+		got, present := b[field]
+		if want == nil {
+			require.False(t, present, "%s should be absent: %s", field, r.raw)
+		} else {
+			require.EqualValues(t, want, got, "%s: %s", field, r.raw)
+		}
+	}
+	list, ok := b["requiredDocTypes"].([]any)
+	require.True(t, ok, "requiredDocTypes is a list: %s", r.raw)
+	var gotRequired []string
+	for _, v := range list {
+		gotRequired = append(gotRequired, fmt.Sprint(v))
+	}
+	require.ElementsMatch(t, required, gotRequired, "requiredDocTypes: %s", r.raw)
+	require.Equal(t, suspend, b["autoSuspendOnWindowExpiry"], "autoSuspendOnWindowExpiry: %s", r.raw)
+	require.Equal(t, profile, b["licenceProfile"], "licenceProfile: %s", r.raw)
+}
