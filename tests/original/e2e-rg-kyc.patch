+// rkBreakUntil is a break end a week out, at whole seconds so it reads back unchanged.
+func rkBreakUntil() string {
+	return time.Now().Add(7 * 24 * time.Hour).UTC().Truncate(time.Second).Format(time.RFC3339)
+}
+
+// rkPlayerBreak is the player's PUT .../cooling-off {"until": until}.
+func rkPlayerBreak(t *testing.T, s setup.Suite, p rkPlayer, until string) rkResult {
+	t.Helper()
+	return rkDo(t, http.MethodPut, rkRgURL(s, p, "/cooling-off"), p.token, map[string]string{"until": until}, nil)
+}
+
+// rkSelfExclude is the player's PUT .../permanent-exclusion.
+func rkSelfExclude(t *testing.T, s setup.Suite, p rkPlayer) rkResult {
+	t.Helper()
+	return rkDo(t, http.MethodPut, rkRgURL(s, p, "/permanent-exclusion"), p.token, nil, nil)
+}
+
+// rkHistoryHas reports whether the player's RG history holds an entry of eventType by actor.
+func rkHistoryHas(t *testing.T, s setup.Suite, p rkPlayer, eventType, actor string) (bool, error) {
+	r := rkDo(t, http.MethodGet, rkRgURL(s, p, "/history"), p.token, nil, nil)
+	if r.status != http.StatusOK {
+		return false, fmt.Errorf("GET history: %d %s", r.status, r.raw)
+	}
+	var entries []map[string]any
+	if err := json.Unmarshal([]byte(r.raw), &entries); err != nil {
+		return false, err
+	}
+	for _, e := range entries {
+		if e["eventType"] == eventType && e["actor"] == actor {
+			return true, nil
+		}
+	}
+	return false, nil
+}
