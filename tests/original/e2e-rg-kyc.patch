+// Scenario 27 — responsible gambling: breaks (cooling-off), self-exclusion and operator
+// exclusion, and their effect on sign-in, game launch and deposits.
+//
+// Drives:
+//
+//	PUT    /v1/casino/rg/{brandId}/{playerId}/cooling-off            (RgRoutes, player JWT)
+//	PUT    /v1/casino/rg/{brandId}/{playerId}/permanent-exclusion    (RgRoutes, player JWT)
+//	GET    /v1/casino/rg/{brandId}/{playerId}/history                (RgRoutes, player JWT)
+//	PUT/DELETE /v1/casino/{brandId}/players/{playerId}/rg/cooling-off (BackofficePlayerRoutes, operator JWT)
+//	POST   /v1/casino/{brandId}/players/{playerId}/self-exclude      (BackofficePlayerRoutes, operator JWT)
+//	POST   /v1/casino/players/{brandId}/login                        (PlayerRoutes)
+//	POST   /v1/casino/sessions/{brandId}/launch                      (SessionRoutes, player JWT)
+//	POST   /internal/v1/casino/{brandId}/notify/deposit              (CasinoServiceMain, X-Internal-Secret)
+//
+// The deposit refusals are the answers of the internal notify route. In the original that route
+// runs after the wallet has credited the deposit and its 403 is logged and ignored by the caller
+// (spec 001 Known defects); the recording here is of the route's answer, which the port moves
+// before the credit.
+//
+// Launch and notify tests first make sure the brand's KYC policy has no gate or threshold
+// (rkEnsureNoKycGates, scenario 29), because the original checks KYC before RG on both paths.
+//
+// Requires EITHEROR_CASINO_URL and EITHEROR_CASINO_INTERNAL_URL (casino-service NodePort, for the
+// internal notify route); operator tests need TEST_OPERATOR_EMAIL / TEST_OPERATOR_PASSWORD.
+package e2e_test
+
+import (
+	"encoding/json"
+	"fmt"
+	"net/http"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/require"
+
+	"github.com/eitheror-io/eitheror-platform/tests/e2e/internal/setup"
+	"github.com/eitheror-io/eitheror-platform/tests/e2e/internal/wait"
+)
