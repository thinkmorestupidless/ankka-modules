+// features/responsible-gambling/limits.feature
+// Scenario: a new raise while one is pending replaces the pending change and restarts its day
+func TestScenario26_RGLimits_NewRaiseReplacesPendingChange(t *testing.T) {
+	setup.SkipIfMissing(t)
+	s := setup.New()
+	p := rkNewPlayer(t, s)
+
+	rkRequireStatus(t, http.StatusOK, rkSetLimit(t, s, p, "DEPOSIT_DAILY", "50"), "set 50")
+	first := rkSetLimit(t, s, p, "DEPOSIT_DAILY", "200")
+	rkRequireStatus(t, http.StatusOK, first, "raise to 200")
+	firstPending, ok := rkDecodeRg(t, first).pending("DEPOSIT_DAILY")
+	require.True(t, ok, "first raise should be pending: %s", first.raw)
+	firstAt, err := time.Parse(time.RFC3339, firstPending.AppliesAt)
+	require.NoError(t, err)
+
+	before := time.Now()
+	second := rkSetLimit(t, s, p, "DEPOSIT_DAILY", "300")
+	after := time.Now()
+	rkRequireStatus(t, http.StatusOK, second, "raise to 300")
+	st := rkDecodeRg(t, second)
+	rkRequireLimit(t, st, "DEPOSIT_DAILY", 50)
+
+	count := 0
+	for _, pc := range st.PendingChanges {
+		if pc.LimitType == "DEPOSIT_DAILY" {
+			count++
+		}
+	}
+	require.Equal(t, 1, count, "only one pending change per limit type: %s", second.raw)
+	pc, _ := st.pending("DEPOSIT_DAILY")
+	require.NotNil(t, pc.PendingValue)
+	require.Equal(t, "300", *pc.PendingValue, "the new raise replaces the earlier pending change")
+	secondAt := rkRequireAppliesAt(t, pc.AppliesAt, before, after)
+	require.False(t, secondAt.Before(firstAt), "the replacement restarts the day: %s should not be before %s", secondAt, firstAt)
+}
