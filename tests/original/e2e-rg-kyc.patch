+
+// features/responsible-gambling/operators.feature
+// Scenario: an operator setting a limit with a pending raise applies it at once, cancels the pending change and is named in the history
+func TestScenario26_RGOperator_SetLimitWithPendingRaiseAppliesAtOnce(t *testing.T) {
+	setup.SkipIfMissing(t)
+	s := setup.New()
+	op := rkOperatorToken(t, s)
+	p := rkNewPlayer(t, s)
+
+	rkRequireStatus(t, http.StatusOK, rkSetLimit(t, s, p, "DEPOSIT_DAILY", "50"), "player sets 50")
+	rkRequireStatus(t, http.StatusOK, rkSetLimit(t, s, p, "DEPOSIT_DAILY", "200"), "player raises to 200")
+
+	res := rkDo(t, http.MethodPut, rkPlayerURL(s, p, "/rg/limits/DEPOSIT_DAILY"), op, map[string]string{"value": "200"}, nil)
+	rkRequireStatus(t, http.StatusOK, res, "operator PUT rg/limits/DEPOSIT_DAILY")
+	rkRequireLimit(t, rkDecodeRg(t, res), "DEPOSIT_DAILY", 200)
+	rkRequireLimit(t, rkGetRg(t, s, p), "DEPOSIT_DAILY", 200)
+
