+// ---------------------------------------------------------------------------
+// documents.feature — A player submits documents and sees where they stand
+// ---------------------------------------------------------------------------
+
+// features/kyc/documents.feature
+// Scenario: a player with no documents sees all six categories with upload actions and the required ones marked
+//
+// The six categories and their upload actions are the frontend's; the original answers the
+// player's documents, the per-player required categories and the status, and the brand's required
+// categories on the public requirements read.
+func TestScenario28_KYCDocuments_NoDocumentsShowsRequiredCategories(t *testing.T) {
