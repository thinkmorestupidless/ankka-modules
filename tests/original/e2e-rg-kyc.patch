+	require.Empty(t, d.Documents, "a fresh player has no documents")
+	require.Empty(t, d.RequiredDocTypes, "no per-player required categories")
+	require.Equal(t, "unverified", d.KycStatus)
+
+	req := rkDo(t, http.MethodGet, fmt.Sprintf("%s/v1/casino/players/%s/kyc/requirements", s.CasinoURL, p.brandId), "", nil, nil)
+	rkRequireStatus(t, http.StatusOK, req, "GET kyc/requirements")
+	required, ok := req.body["requiredDocTypes"].([]any)
+	require.True(t, ok, "the brand's required categories are listed: %s", req.raw)
+	require.NotEmpty(t, required)
