diff --git a/tests/e2e/record_test.go b/tests/e2e/record_test.go
new file mode 100644
index 00000000..4b34c9db
--- /dev/null
+++ b/tests/e2e/record_test.go
@@ -0,0 +1,30 @@
+//go:build e2e
+
+package e2e_test
+
+// Recording the original for the rebuild (ankka-casino spec 001 FR-030). With EITHEROR_RECORD_TO
+// set, every request a test makes through the default HTTP client is recorded, one file per test
+// function, and any request to a host outside this machine is refused. Without it, nothing changes.
+// Added by ankka-casino/tests/original/e2e-recording.patch; see that repository's tests/original/README.md.
+
+import (
+	"os"
+	"strings"
+
+	"github.com/eitheror-io/ankka-casino/tests/original/recorder"
+)
+
+var _ = recorder.Install("e2e_test", os.Getenv)
+
+// recLetters spells a run id's digits as letters (0-9 → g-p) for the emails the suite registers.
+// casino-service's duplicate check (#730) strips digits from an email's local part and treats a
+// shared result from the same IP within 24 hours as a strong signal, so hex run ids made players of
+// one recording run duplicates of another's. Letters keep each email distinct after stripping.
+func recLetters(runId string) string {
+	return strings.Map(func(r rune) rune {
+		if r >= '0' && r <= '9' {
+			return 'g' + (r - '0')
+		}
+		return r
+	}, runId)
+}
