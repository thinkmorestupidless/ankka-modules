        "service": "casino",
        "headers": {
          "Content-Type": "application/json",
          "X-Forwarded-For": "192.0.2.44"
        },
        "body": {
          "country": "DE",
          "currency": "EUR",
          "email": "{email}",
          "language": "en",
          "password": "\u003credacted\u003e"
        }
      },
      "response": {
        "status": 201,
        "body": {
          "playerId": "251fbf4e-2cd2-3ff8-bfa2-9eb8e71cbf67",
