    {
      "name": "setup: the brand's settings at the original's defaults, fees at zero",
      "request": {
        "method": "PUT",
        "path": "/v1/affiliates/{brand}/settings",
        "service": "programme",
        "headers": {
          "Authorization": "Bearer {staffToken}",
          "Content-Type": "application/json"
        },
        "body": {
          "adminFeePercent": "0",
          "bonusCostThreshold": "3",
          "chargebackThreshold": "2",
          "paymentFeePercent": "0",
          "payoutCycleDay": "1",
          "providerFeePercent": "0"
        }
      },
      "response": {
        "status": 200,
        "body": {
          "ok": true
        }
      }
    },
    {
      "name": "create the plan",
      "request": {
        "method": "POST",
        "path": "/v1/affiliates/{brand}/commission-plans",
        "service": "programme",
        "headers": {
          "Authorization": "Bearer {staffToken}",
          "Content-Type": "application/json"
        },
        "body": {
          "cpaAmount": "50.00",
          "minimumDepositThreshold": "20.00",
          "negativeCarryover": "false",
          "planName": "Plan {run}",
          "planType": "CPA"
        }
      },
      "response": {
        "status": 201,
        "body": {
          "planId": "{plan}",
          "planName": "Plan {run}"
        }
      },
      "capture": {
        "plan": "$.planId"
      }
    },
    {
