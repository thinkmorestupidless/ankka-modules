        "body": {
          "cpaAmount": "50.00",
          "minimumDepositThreshold": "20.00",
          "negativeCarryover": "false",
          "planName": "Plan {run}",
          "planType": "CPA"
        }
      },
      "response": {
        "status": 201,
        "body": {
          "planId": "{plan}",
          "planName": "Plan {run}"
        }
      },
      "capture": {
        "plan": "$.planId"
      }
