{
  "scenario": "a plan created or changed applies to the memberships that name it from the next fact onward and is audited",
  "requirement": "013/FR-006",
  "recorded_at": "2026-11-07T09:39:40.114151Z",
  "original": {
    "brand": "spinvibe",
    "commit": "7630feb0a369729b9696c756cce0d841cd0d80d9"
  },
  "runs": 2,
  "service": "programme",
  "steps": [
    {
      "name": "create the plan",
      "request": {
        "method": "POST",
        "path": "/v1/affiliates/{brand}/commission-plans",
        "service": "programme",
        "headers": {
          "Authorization": "Bearer {staffToken}",
          "Content-Type": "application/json"
        },
        "body": {
          "cpaAmount": "50.00",
          "minimumDepositThreshold": "20.00",
          "negativeCarryover": "false",
          "planName": "Plan {run}",
          "planType": "CPA"
        }
      },
      "response": {
        "status": 201,
        "body": {
          "planId": "{plan}",
          "planName": "Plan {run}"
        }
      }
    },
    {
      "name": "create the plan again",
      "request": {
        "method": "POST",
        "path": "/v1/affiliates/{brand}/commission-plans",
        "service": "programme",
        "headers": {
          "Authorization": "Bearer {staffToken}",
          "Content-Type": "application/json"
        },
        "body": {
          "cpaAmount": "50.00",
          "planName": "Plan {run}",
          "planType": "CPA"
        }
      },
      "response": {
        "status": 409,
        "body": {
          "error": "plan_already_exists"
        }
      }
    },
    {
      "name": "change the plan",
      "request": {
        "method": "PATCH",
        "path": "/v1/affiliates/{brand}/commission-plans/{plan}",
        "service": "programme",
        "headers": {
          "Authorization": "Bearer {staffToken}",
          "Content-Type": "application/json"
        },
        "body": {
          "cpaAmount": "75.00",
          "minimumDepositThreshold": "25.00"
        }
      },
      "response": {
        "status": 200,
        "body": {
          "planId": "{plan}"
        }
      }
    },
