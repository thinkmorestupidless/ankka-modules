  "steps": [
    {
      "name": "create the plan",
      "request": {
        "method": "POST",
        "path": "/v1/affiliates/{brand}/commission-plans",
        "service": "programme",
        "headers": {
          "Authorization": "Bearer {staffToken}",
          "Content-Type": "application/json"
        },
        "body": {
          "cpaAmount": "50.00",
          "minimumDepositThreshold": "20.00",
          "negativeCarryover": "false",
          "planName": "Plan {run}",
          "planType": "CPA"
        }
      },
      "response": {
        "status": 201,
        "body": {
          "planId": "{plan}",
          "planName": "Plan {run}"
        }
      },
      "capture": {
        "plan": "$.planId"
      }
    },
    {
      "name": "create the account: parent",
      "request": {
        "method": "POST",
        "path": "/v1/affiliates/{brand}/accounts",
        "service": "programme",
        "headers": {
          "Authorization": "Bearer {staffToken}",
          "Content-Type": "application/json"
        },
        "body": {
          "email": "parent-{run}@example.com",
          "name": "Driver parent",
          "planId": "{plan}"
        }
      },
      "response": {
        "status": 201,
        "body": {
          "affiliateId": "a57beb15-d5a0-41e6-bba1-d0bf40679928",
          "email": "parent-{run}@example.com"
        }
      },
      "capture": {
        "parent": "$.affiliateId"
      },
      "vary": {
        "$.affiliateId": "differs between two runs of the original"
      }
    },
    {
