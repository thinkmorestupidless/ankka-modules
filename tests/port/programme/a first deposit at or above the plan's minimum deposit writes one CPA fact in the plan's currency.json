  "steps": [
    {
      "name": "create the plan",
      "request": {
        "method": "POST",
        "path": "/v1/affiliates/{brand}/commission-plans",
        "service": "programme",
        "headers": {
          "Authorization": "Bearer {staffToken}",
          "Content-Type": "application/json"
        },
        "body": {
          "cpaAmount": "50.00",
          "minimumDepositThreshold": "20.00",
          "negativeCarryover": "false",
          "planName": "Plan {run}",
          "planType": "CPA"
        }
      },
      "response": {
        "status": 201,
        "body": {
          "planId": "{plan}",
          "planName": "Plan {run}"
        }
      }
    },
    {
      "name": "create the account: affiliate",
      "request": {
        "method": "POST",
        "path": "/v1/affiliates/{brand}/accounts",
        "service": "programme",
        "headers": {
          "Authorization": "Bearer {staffToken}",
          "Content-Type": "application/json"
        },
        "body": {
          "email": "affiliate-{run}@example.com",
          "name": "Driver affiliate",
          "planId": "{plan}"
        }
      },
      "response": {
        "status": 201,
        "body": {
          "affiliateId": "4aa3f430-1745-468a-a0de-e337eed8df8e",
          "email": "affiliate-{run}@example.com"
        }
      },
      "capture": {
        "affiliate": "$.affiliateId"
      },
      "vary": {
        "$.affiliateId": "differs between two runs of the original"
      }
    },
    {
