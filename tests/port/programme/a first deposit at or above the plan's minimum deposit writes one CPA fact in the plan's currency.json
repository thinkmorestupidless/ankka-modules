{
  "scenario": "a first deposit at or above the plan's minimum deposit writes one CPA fact in the plan's currency",
  "requirement": "013/FR-013",
  "recorded_at": "2026-11-07T09:39:40.405403Z",
  "original": {
    "brand": "spinvibe",
