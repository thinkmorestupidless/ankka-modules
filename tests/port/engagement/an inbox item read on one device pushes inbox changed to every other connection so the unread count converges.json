          "Content-Type": "application/json"
        },
        "body": {
          "body": "An operator has left you a note.",
          "category": "service",
          "idempotencyKey": "{messageKey}",
          "title": "Your account"
        }
      },
      "response": {
        "status": 201,
        "body": {
          "body": "An operator has left you a note.",
          "createdAt": "2026-11-08T08:02:28.671497292Z",
