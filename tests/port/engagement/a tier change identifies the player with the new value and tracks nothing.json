  "service": "engagement",
  "steps": [
    {
      "name": "setup: register the player",
      "request": {
        "method": "POST",
        "path": "/v1/casino/players/spinvibe/register",
        "service": "casino",
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "country": "GB",
          "currency": "EUR",
          "dateOfBirth": "1990-01-01",
          "email": "{email}",
          "language": "en",
          "password": "<redacted>"
        }
      },
      "response": {
        "status": 201,
        "body": {
          "playerId": "d5a5f0b2-55c0-3f80-bb52-93292bbedeca",
          "status": "pending_email_verification"
        }
      },
      "capture": {
        "playerId": "$.playerId"
      },
      "vary": {
        "$.playerId": "differs between two runs of the original"
      }
    },
    {
      "name": "setup: follow the player's verification link",
      "request": {
        "method": "POST",
        "path": "/v1/casino/players/spinvibe/verify-email",
        "service": "casino",
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "token": "{link}"
        }
      },
      "response": {
        "status": 200,
        "body": {
          "status": "verified"
        }
      }
    },
    {
      "name": "setup: sign the player in",
      "request": {
        "method": "POST",
        "path": "/v1/casino/players/spinvibe/login",
        "service": "casino",
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "email": "{email}",
          "password": "<redacted>"
        }
      },
      "response": {
        "status": 200,
        "body": {
          "brandId": "spinvibe",
          "country": "GB",
          "currency": "EUR",
          "pendingBonusCode": "",
          "playerId": "d5a5f0b2-55c0-3f80-bb52-93292bbedeca",
          "refreshToken": "<redacted>",
          "token": "<redacted>"
        }
      },
      "capture": {
        "token": "$.token"
      },
      "vary": {
        "$.playerId": "differs between two runs of the original"
      }
    },
    {
      "name": "an operator changes the player's tier",
      "request": {
        "method": "PUT",
        "path": "/v1/casino/spinvibe/players/{playerId}/vip-tier",
        "service": "casino",
        "headers": {
          "Authorization": "Bearer {operatorToken}",
          "Content-Type": "application/json"
        },
        "body": {
          "tier": "gold"
        }
      },
      "response": {
        "status": 200,
        "body": {
          "vipTier": "gold"
        }
      }
    }
  ],
