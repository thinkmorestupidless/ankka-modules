  "steps": [
    {
      "name": "setup: register the player",
      "request": {
        "method": "POST",
        "path": "/v1/casino/players/spinvibe/register",
        "service": "casino",
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "country": "GB",
          "currency": "EUR",
          "dateOfBirth": "1990-01-01",
          "email": "{email}",
          "language": "en",
          "password": "<redacted>"
        }
      },
      "response": {
        "status": 201,
        "body": {
          "playerId": "4b8dcc84-b6b8-3b67-a6c7-d220cfe99122",
          "status": "pending_email_verification"
        }
      },
      "capture": {
        "playerId": "$.playerId"
      },
      "vary": {
        "$.playerId": "differs between two runs of the original"
      }
    },
    {
      "name": "setup: follow the player's verification link",
      "request": {
        "method": "POST",
        "path": "/v1/casino/players/spinvibe/verify-email",
        "service": "casino",
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "token": "{link}"
        }
      },
      "response": {
        "status": 200,
        "body": {
          "status": "verified"
        }
      }
    },
    {
      "name": "setup: sign the player in",
      "request": {
        "method": "POST",
        "path": "/v1/casino/players/spinvibe/login",
        "service": "casino",
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "email": "{email}",
          "password": "<redacted>"
        }
      },
      "response": {
        "status": 200,
        "body": {
          "brandId": "spinvibe",
          "country": "GB",
          "currency": "EUR",
          "pendingBonusCode": "",
          "playerId": "4b8dcc84-b6b8-3b67-a6c7-d220cfe99122",
          "refreshToken": "<redacted>",
          "token": "<redacted>"
        }
      },
      "capture": {
        "token": "$.token"
      },
      "vary": {
        "$.playerId": "differs between two runs of the original"
      }
    },
    {
      "name": "the player opens the stream",
      "request": {
        "method": "GET",
        "path": "/v1/stream",
        "service": "push",
        "headers": {
          "Accept": "text/event-stream",
          "Authorization": "Bearer {token}"
        }
      },
      "response": {
        "status": 200,
        "body": [
