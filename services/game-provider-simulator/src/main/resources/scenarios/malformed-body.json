{
  "name": "malformed-body",
  "version": 1,
  "description": "A body that is not a JSON object; passes only if the brand answers HTTP 400, which is never retried.",
  "source": "St8Routes.scala (a malformed body is HTTP 400 session_expired); spec 003 FR-004",
  "shape": "harness",
  "schedule": {
    "wait": "5s",
    "intervals": [
      {
        "every": "30s",
        "for": "10m"
      },
      {
        "every": "10m"
      }
    ],
    "cap": "8h"
  },
  "steps": [
    {
      "kind": "send",
      "callback": "debit",
      "malformed": true
    },
    {
      "kind": "expect",
      "of": 0,
      "httpStatus": 400,
      "status": [
        "session_expired"
      ],
      "attempts": {
        "max": 1
      }
    }
  ]
}
