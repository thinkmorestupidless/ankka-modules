{
  "openapi": "3.1.0",
  "info": {
    "title": "wallet",
    "version": "0.0.0"
  },
  "paths": {
    "/v1/casino/players/the-brand/wallets/{currency}/balance": {
      "get": {
        "operationId": "get_v1_casino_players_the_brand_wallets_currency_balance",
        "summary": "The signed-in player's balance in one currency, in major units",
        "tags": [
          "player"
        ],
        "parameters": [
          {
            "name": "currency",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MajorBalance"
                }
              }
            }
          },
          "400": {
            "description": "INVALID_REQUEST",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RefusalBody"
                }
              }
            }
          },
          "403": {
            "description": "player_id_mismatch",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RefusalBody"
                }
              }
            }
          },
          "default": {
            "description": "refused",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RefusalBody"
                }
              }
            }
          }
        },
        "x-ankka-admission": "not-open"
      }
    },
