          "realBalance": {
            "type": "string"
          },
          "bonusBalance": {
            "type": "string"
          },
          "currency": {
            "type": "string"
          },
          "primary": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/MajorPrimary"
              },
              {
                "type": "null"
              }
            ]
          },
          "depositPoolBalance": {
            "type": "string"
          },
          "convertedPoolBalance": {
            "type": "string"
          },
          "reserved": {
            "type": "string"
          },
          "available": {
            "type": "string"
          }
        },
        "required": [
          "realBalance",
          "bonusBalance",
          "currency",
          "depositPoolBalance",
          "convertedPoolBalance",
          "reserved",
          "available"
        ]
      },
      "MajorPrimary": {
        "type": "object",
        "properties": {
          "grantRef": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "wageringRequirement": {
            "type": "string"
          },
          "wagered": {
            "type": "string"
          },
          "progressPercent": {
            "type": "integer",
            "format": "int64"
          }
        },
        "required": [
          "grantRef",
          "status",
          "wageringRequirement",
          "wagered",
          "progressPercent"
        ]
      },
      "MajorTransaction": {
        "type": "object",
        "properties": {
          "transactionId": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "walletType": {
            "type": "string"
          },
          "amount": {
            "type": "string"
          },
          "balanceBefore": {
            "type": "string"
          },
          "balanceAfter": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "roundId": {
            "type": [
              "string",
              "null"
            ]
          },
          "awardRef": {
            "type": [
              "string",
              "null"
            ]
          },
          "paymentReference": {
            "type": [
              "string",
              "null"
            ]
          },
          "createdAt": {
            "type": "string"
          },
          "depositPart": {
            "type": "string"
          },
          "convertedPart": {
            "type": "string"
          },
          "depositPoolAfter": {
            "type": "string"
          },
          "convertedPoolAfter": {
            "type": "string"
          },
          "reference": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "transactionId",
          "type",
          "walletType",
          "amount",
          "balanceBefore",
          "balanceAfter",
          "status",
          "createdAt",
          "depositPart",
          "convertedPart",
          "depositPoolAfter",
          "convertedPoolAfter"
        ]
      },
      "MajorTransactions": {
        "type": "object",
        "properties": {
          "transactions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MajorTransaction"
            }
          },
          "page": {
            "type": "integer"
          },
          "pageSize": {
            "type": "integer"
          },
          "total": {
            "type": "integer",
            "format": "int64"
          }
        },
        "required": [
          "page",
          "pageSize",
          "total"
        ]
      },
      "RecordStatus": {
        "type": "object",
        "properties": {
          "recordId": {
            "type": "string"
          },
          "grantRef": {
            "type": "string"
          },
          "bonusRef": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "priority": {
            "type": "integer",
            "format": "int64"
          },
          "grantedAt": {
            "type": "string"
          },
          "expiresAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "balance": {
            "type": "integer",
            "format": "int64"
          },
          "wageringRequirement": {
            "type": "integer",
            "format": "int64"
          },
          "releaseProgress": {
            "type": "integer",
            "format": "int64"
          },
          "maxConvertible": {
            "type": "integer",
            "format": "int64"
          },
          "remainingAllowance": {
            "type": "integer",
            "format": "int64"
          },
          "depositsSinceConversion": {
            "type": "integer",
            "format": "int64"
          },
          "openRoundCount": {
            "type": "integer",
            "format": "int64"
          },
          "forfeitOnWithdrawal": {
            "type": "string"
          }
