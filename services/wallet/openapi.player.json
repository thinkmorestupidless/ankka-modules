      "get": {
        "operationId": "get_v1_casino_players_the_brand_wallets_currency_restricted_funds",
        "summary": "The signed-in player's restricted funds in one currency: each bonus record and the headline one",
        "tags": [
          "player"
        ],
        "parameters": [
          {
            "name": "currency",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RestrictedFundsStatus"
                }
              }
            }
          },
          "400": {
            "description": "INVALID_REQUEST",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RefusalBody"
                }
              }
            }
          },
          "403": {
            "description": "player_id_mismatch",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RefusalBody"
                }
              }
            }
          },
          "default": {
            "description": "refused",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RefusalBody"
                }
              }
            }
          }
        },
        "x-ankka-admission": "not-open"
      }
    },
    "/v1/casino/players/the-brand/wallets/{currency}/transactions": {
      "get": {
        "operationId": "get_v1_casino_players_the_brand_wallets_currency_transactions",
        "summary": "One page of the signed-in player's transactions in one currency, newest first, in major units",
        "tags": [
          "player"
        ],
        "parameters": [
          {
            "name": "currency",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "from",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "to",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "type",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "walletType",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MajorTransactions"
                }
              }
            }
          },
          "400": {
            "description": "INVALID_REQUEST",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RefusalBody"
                }
              }
            }
          },
          "403": {
            "description": "player_id_mismatch",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RefusalBody"
                }
              }
            }
          },
          "default": {
            "description": "refused",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RefusalBody"
                }
              }
            }
          }
        },
        "x-ankka-admission": "not-open"
      }
    }
