        "required": [
          "recordId",
          "grantRef",
          "bonusRef",
          "status",
          "priority",
          "grantedAt",
          "balance",
          "wageringRequirement",
          "releaseProgress",
          "maxConvertible",
          "remainingAllowance",
          "depositsSinceConversion",
          "openRoundCount"
        ]
      },
      "RefusalBody": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "details": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        },
        "required": [
          "error",
          "message"
        ]
      },
      "RestrictedFundsStatus": {
        "type": "object",
        "properties": {
          "records": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RecordStatus"
            }
          },
          "headline": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/RecordStatus"
              },
              {
                "type": "null"
              }
            ]
          },
          "restrictedBalance": {
            "type": "integer",
            "format": "int64"
          }
        },
        "required": [
          "restrictedBalance"
        ]
      }
