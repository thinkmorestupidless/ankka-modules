        "currency" : "GBP",
        "created_at" : "2026-06-15T10:00:00Z",
        "terminal_id" : "t1",
        "psp_id" : "dreamzpay",
        "turnover_multiplier" : 0,
        "turnover_definition" : "gross_wagered"
      }
    },
    "then" : {
      "mutations" : [ {
