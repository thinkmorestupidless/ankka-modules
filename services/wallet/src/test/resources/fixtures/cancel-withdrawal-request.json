  "cases" : [ {
    "name" : "plan request — refunds requested_amount",
    "line" : 8,
    "given" : [ {
      "id" : "wallet/test1",
      "concepts" : [ "Wallet" ],
      "real_balance" : 40000,
      "pending_withdrawal_request_ref" : "withdrawal-request/req1",
      "player_id" : "p1",
      "brand_id" : "testbrand",
      "currency" : "GBP"
    }, {
      "id" : "withdrawal-request/req1",
      "concepts" : [ "WithdrawalRequest" ],
      "status" : "PENDING_REVIEW",
      "amount" : 25000,
      "requested_amount" : 100000,
      "voided_amount" : 75000,
      "currency" : "GBP"
    } ],
    "when" : {
      "command" : "CancelWithdrawalRequest",
      "params" : {
        "request_id" : "withdrawal-request/req1",
        "resolved_at" : "2026-06-15T11:00:00Z",
        "amount" : 25000,
        "amount_str" : "250.00",
        "currency" : "GBP",
        "request_status" : "PENDING_REVIEW"
      }
    },
    "then" : {
      "mutations" : [ {
        "index" : 0,
        "op" : "set_properties",
        "target" : "withdrawal-request/req1",
        "properties" : {
          "status" : "CANCELLED",
          "resolved_at" : "2026-06-15T11:00:00Z",
          "balance_after_return" : 140000
        }
      }, {
        "index" : 1,
        "op" : "set_properties",
        "target" : "wallet/test1",
        "properties" : {
          "real_balance" : 140000,
          "pending_withdrawal_request_ref" : null
        }
      }, {
        "index" : 2,
        "op" : "set_properties",
        "target" : "transaction.new-id",
        "properties" : {
          "type" : "withdrawal_return",
          "wallet_type" : "real",
          "amount" : 100000,
          "balance_before" : 40000,
          "balance_after" : 140000,
          "currency" : "GBP",
          "status" : "settled",
          "player_ref" : "p1",
          "brand_ref" : "testbrand",
          "created_at" : "2026-06-15T11:00:00Z"
        }
      }, {
        "index" : 3,
        "op" : "add_concept",
        "target" : "transaction.new-id",
        "properties" : {
          "concept" : "ent.wallet.transaction_v1"
        }
      }, {
        "index" : 4,
        "op" : "add_edge",
        "target" : "wallet/test1",
        "args" : [ "HAS_TRANSACTION", {
          "$any" : true
        } ]
      } ],
      "result" : {
        "requestId" : "withdrawal-request/req1",
        "status" : "CANCELLED",
        "refunded" : 100000,
        "voidedReturned" : 75000
      },
      "error" : null,
      "mutation_count" : 5
    }
