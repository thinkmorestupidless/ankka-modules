{
  "handler" : "reverse-withdrawal-request",
  "source" : "eitheror-platform/starter-packs/wallet/handlers/reverse-withdrawal-request.test.tl",
  "cases" : [ {
    "name" : "happy path — reverses a completed withdrawal and credits wallet",
    "line" : 1,
    "given" : [ {
      "id" : "wallet/test1",
      "real_balance" : 200.00,
      "bonus_balance" : 0.00,
      "player_id" : "p1",
      "brand_id" : "testbrand",
      "currency" : "EUR"
    } ],
    "when" : {
      "command" : "ReverseWithdrawalRequest",
      "params" : {
        "request_id" : "withdrawal-request/wr1",
        "current_request_status" : "COMPLETED",
        "reversed_at" : "2026-07-31T14:00:00Z",
        "amount" : 150.00,
        "currency" : "EUR"
      }
    },
    "then" : {
      "mutations" : [ {
        "index" : 0,
        "op" : "set_properties",
        "target" : "withdrawal-request/wr1",
        "properties" : {
          "status" : "REVERSED",
          "reversed_at" : "2026-07-31T14:00:00Z"
        }
      }, {
        "index" : 1,
        "op" : "set_properties",
        "target" : "wallet/test1",
        "properties" : {
          "real_balance" : 350.00
        }
      }, {
        "index" : 2,
        "op" : "set_properties",
        "target" : "transaction.new-id",
        "properties" : {
          "type" : "withdrawal_reversal",
          "wallet_type" : "real",
          "amount" : 150.00,
          "balance_before" : 200.00,
          "balance_after" : 350.00,
          "currency" : "EUR",
          "status" : "settled",
          "player_ref" : "p1",
          "brand_ref" : "testbrand",
          "created_at" : "2026-07-31T14:00:00Z"
        }
      }, {
        "index" : 3,
        "op" : "add_edge",
        "target" : "wallet/test1",
        "args" : [ "HAS_TRANSACTION", {
          "$any" : true
        } ]
      } ],
      "result" : {
        "requestId" : "withdrawal-request/wr1",
        "status" : "REVERSED",
        "reversedAt" : "2026-07-31T14:00:00Z"
      },
      "error" : null
    }
  }, {
    "name" : "error — cannot reverse a withdrawal not in COMPLETED state",
    "line" : 26,
    "given" : [ {
      "id" : "wallet/test2",
      "real_balance" : 500.00,
      "bonus_balance" : 0.00,
      "player_id" : "p2",
      "brand_id" : "testbrand",
      "currency" : "EUR"
    } ],
    "when" : {
      "command" : "ReverseWithdrawalRequest",
      "params" : {
        "request_id" : "withdrawal-request/wr2",
        "current_request_status" : "INITIATED",
        "reversed_at" : "2026-07-31T14:00:00Z",
        "amount" : 100.00,
        "currency" : "EUR"
      }
    },
    "then" : {
      "mutations" : [ ],
      "result" : null,
      "error" : {
        "code" : "WITHDRAWAL_NOT_IN_COMPLETED_STATE"
      }
    }
  }, {
    "name" : "idempotency — reversing an already-reversed withdrawal returns success without mutation",
    "line" : 45,
    "given" : [ {
      "id" : "wallet/test3",
      "real_balance" : 350.00,
      "bonus_balance" : 0.00,
      "player_id" : "p3",
      "brand_id" : "testbrand",
      "currency" : "EUR"
    } ],
    "when" : {
      "command" : "ReverseWithdrawalRequest",
      "params" : {
        "request_id" : "withdrawal-request/wr3",
        "current_request_status" : "REVERSED",
        "reversed_at" : "2026-07-31T14:00:00Z",
        "amount" : 150.00,
        "currency" : "EUR"
      }
    },
    "then" : {
      "mutations" : [ ],
      "result" : {
        "requestId" : "withdrawal-request/wr3",
        "status" : "REVERSED",
        "idempotent" : true
      },
      "error" : null
    }
  } ]
}
