{
  "name": "backoffice",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node src/server/main.ts",
    "build": "vite build",
    "start": "NODE_ENV=production node src/server/main.ts",
    "typecheck": "tsc",
    "test": "vitest run --dir tests/unit",
    "features": "bddgen --config tests/features/playwright.config.ts && playwright test --config tests/features/playwright.config.ts",
    "a11y": "playwright test --config tests/a11y/playwright.config.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.8",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-router": "^1.170.46",
    "d3-geo": "^3.1.2",
    "hono": "^4.13.18",
    "intl-messageformat": "^12.1.5",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/d3-geo": "^3.1.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "jsdom": "^31.0.1",
    "playwright-bdd": "^9.2.1",
    "tailwindcss": "^4.3.5",
    "typescript": "~5.9",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
