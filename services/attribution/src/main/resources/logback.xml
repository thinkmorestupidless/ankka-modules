<configuration>
  <!-- With no logback.xml on the classpath logback falls back to everything-at-DEBUG, and for a
       deployed service that means the whole r2dbc wire protocol, row by row, on stdout.
       logback.xml rather than logback-test.xml, so it is what the packaged image uses; the testkit's
       own logback-test.xml still wins under test. No body and no header is logged anywhere in this
       service (SC-006): a line names a click id, a player id, a network and an outcome, never a tag,
       an address or a key. -->
  <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%d{HH:mm:ss.SSS} %-5level %logger{30} - %msg%replace( trace_id=%X{trace_id} span_id=%X{span_id}){' trace_id= span_id=$', ''}%n</pattern>
    </encoder>
  </appender>

  <root level="INFO">
    <appender-ref ref="STDOUT"/>
  </root>
</configuration>
