{
  "openapi": "3.1.0",
  "info": {
    "title": "game-provider",
    "version": "0.0.0"
  },
  "paths": {
    "/v1/casino/catalog/developers": {
      "get": {
        "operationId": "get_v1_casino_catalog_developers",
        "summary": "The developers of the games listed",
        "tags": [
          "player"
        ],
        "parameters": [
          {
            "name": "brand",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "country",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Developers"
                }
              }
            }
          },
          "404": {
            "description": "wrong_brand",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Refusal"
                }
              }
            }
          },
          "default": {
            "description": "refused",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Refusal"
                }
              }
            }
          }
        },
        "security": [
          
        ]
      }
    },
    "/v1/casino/catalog/games": {
      "get": {
        "operationId": "get_v1_casino_catalog_games",
        "summary": "The lobby: the games listed, filtered, or the ones named by id",
        "tags": [
          "player"
        ],
        "parameters": [
          {
            "name": "bonusTypes",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "brand",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "category",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "country",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "developer",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "features",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "ids",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "search",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "tag",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "themes",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Games"
                }
              }
            }
          },
          "404": {
            "description": "wrong_brand",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Refusal"
                }
              }
            }
          },
          "default": {
            "description": "refused",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Refusal"
                }
              }
            }
          }
        },
        "security": [
          
        ]
      }
    },
    "/v1/casino/catalog/games/{gameCode}": {
      "get": {
        "operationId": "get_v1_casino_catalog_games_gameCode",
        "summary": "One listed game, by its code",
        "tags": [
          "player"
        ],
        "parameters": [
          {
            "name": "gameCode",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "brand",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "provider",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Game"
                }
              }
            }
          },
          "400": {
            "description": "ambiguous_game_code",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Refusal"
                }
              }
            }
          },
          "404": {
            "description": "game_not_found, wrong_brand",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Refusal"
                }
              }
            }
          },
          "default": {
            "description": "refused",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Refusal"
                }
              }
            }
          }
        },
        "security": [
          
        ]
      }
    },
    "/v1/casino/catalog/{brand}/games/popular": {
      "get": {
        "operationId": "get_v1_casino_catalog_brand_games_popular",
        "summary": "The brand's most played games, most played first",
        "tags": [
          "player"
        ],
        "parameters": [
          {
            "name": "brand",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Popular"
                }
              }
            }
          },
          "404": {
            "description": "wrong_brand",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Refusal"
                }
              }
            }
          },
          "default": {
            "description": "refused",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Refusal"
                }
              }
            }
          }
        },
        "security": [
          
        ]
      }
    },
    "/v1/casino/sessions/{brand}/launch": {
      "post": {
        "operationId": "post_v1_casino_sessions_brand_launch",
        "summary": "Launch a game for the signed-in player: the provider's game address and the session opened",
        "tags": [
          "player"
        ],
        "parameters": [
          {
            "name": "brand",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Launch"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Launched"
                }
              }
            }
          },
          "400": {
            "description": "playerId required, gameId required, provider_required, free_spins_grant_invalid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Refusal"
                }
              }
            }
          },
          "403": {
            "description": "player_id_mismatch, account_restricted, PLAY_BLOCKED_KYC, cooling_off_active, session_limit_reached",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Refusal"
                }
              }
            }
          },
          "404": {
            "description": "wrong_brand",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Refusal"
                }
              }
            }
          },
          "429": {
            "description": "RATE_LIMITED",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Refusal"
                }
              }
            }
          },
          "500": {
            "description": "launch_failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Refusal"
                }
              }
            }
          },
          "503": {
            "description": "st8_not_configured, service_unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Refusal"
                }
              }
            }
          },
          "default": {
            "description": "refused",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Refusal"
                }
              }
            }
          }
        },
        "x-ankka-admission": "not-open"
      }
    }
  },
  "components": {
    "schemas": {
      "Developer": {
        "type": "object",
        "properties": {
          "developerId": {
            "type": "string"
          },
          "developerName": {
            "type": "string"
          }
        },
        "required": [
          "developerId",
          "developerName"
        ]
      },
      "Developers": {
        "type": "object",
        "properties": {
          "developers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Developer"
            }
          }
        }
      },
      "Game": {
        "type": "object",
        "properties": {
          "gameId": {
            "type": "string"
          },
          "provider": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "developerId": {
            "type": "string"
          },
          "developerName": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "enabled": {
            "type": "boolean"
          },
          "funMode": {
            "type": "boolean"
          },
          "bonusTypes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "features": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "themes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "restrictedTerritories": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "prohibitedTerritories": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "thumbnailUrl": {
            "type": [
              "string",
              "null"
            ]
          },
          "rtp": {
            "type": [
              "string",
              "null"
            ]
          },
          "volatility": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          },
          "hitRatio": {
            "type": [
              "string",
              "null"
            ]
          },
          "maxPayoutCoeff": {
            "type": [
              "string",
              "null"
            ]
          },
          "releaseDate": {
            "type": [
              "string",
              "null"
            ]
          },
          "deprecationDate": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "gameId",
          "provider",
          "name",
          "category",
          "developerId",
          "developerName",
          "enabled",
          "funMode"
        ]
      },
      "Games": {
        "type": "object",
        "properties": {
          "games": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Game"
            }
          },
          "total": {
            "type": [
              "integer",
              "null"
            ]
          },
          "nextOffset": {
            "type": [
              "integer",
              "null"
            ]
          }
        }
      },
      "Launch": {
        "type": "object",
        "properties": {
          "playerId": {
            "type": "string"
          },
          "gameId": {
            "type": "string"
          },
          "demo": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "provider": {
            "type": [
              "string",
              "null"
            ]
          },
          "currency": {
            "type": [
              "string",
              "null"
            ]
          },
          "freeSpinsGrantRef": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "playerId",
          "gameId"
        ]
      },
      "Launched": {
        "type": "object",
        "properties": {
          "launchToken": {
            "type": "string"
          },
          "gameUrl": {
            "type": "string"
          },
          "sessionId": {
            "type": "string"
          },
          "freeSpinsGrantRef": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "launchToken",
          "gameUrl",
          "sessionId"
        ]
      },
      "Popular": {
        "type": "object",
        "properties": {
          "gameIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "Refusal": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          }
        },
        "required": [
          "error"
        ]
      }
    }
  }
}
