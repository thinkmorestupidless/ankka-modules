# What `just describe support-agent` runs the service with (spec 031, contracts/descriptions.md): the
# placeholders its settings demand, no secret. The brand is the-brand, which a kept path names and
# the SDK's generator reads as {brand}.
CASINO_BRAND=the-brand
# The issuers its settings demand by name; no realm is reached while the document is written.
ANKKA_AUTH_ISSUERS=player,staff
# A placeholder, not a key: the document is written before any model is called.
MODEL_PROVIDER_KEY=placeholder-not-a-key
# Naming issuers makes ankka demand each one's settings; nothing is fetched while the document is written.
ANKKA_AUTH_PLAYER_ISSUER=https://auth.invalid/realms/casino-the-brand
ANKKA_AUTH_PLAYER_JWKS_URL=https://auth.invalid/realms/casino-the-brand/certs
ANKKA_AUTH_PLAYER_AUDIENCE=the-brand
ANKKA_AUTH_STAFF_ISSUER=https://auth.invalid/realms/eitheror
ANKKA_AUTH_STAFF_JWKS_URL=https://auth.invalid/realms/eitheror/certs
ANKKA_AUTH_STAFF_AUDIENCE=eitheror-casino
