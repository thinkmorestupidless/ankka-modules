    "/v1/casino/kyc/the-brand/{playerId}/uploads": {
      "post": {
        "operationId": "post_v1_casino_kyc_the_brand_playerId_uploads",
        "summary": "Offer an upload: a link to put one file of a category to, for an hour",
        "tags": [
          "player"
        ],
        "parameters": [
          {
            "name": "playerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Upload"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Offered"
                }
              }
            }
          },
          "400": {
            "description": "invalid_body, invalid_category, file_rejected",
