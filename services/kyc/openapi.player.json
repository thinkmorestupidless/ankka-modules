  "components": {
    "schemas": {
      "CategoryRow": {
        "type": "object",
        "properties": {
          "category": {
            "type": "string"
          },
          "requiredByPolicy": {
            "type": "boolean"
          },
          "requiredOfPlayer": {
            "type": "boolean"
          },
          "document": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Document"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "category",
          "requiredByPolicy",
          "requiredOfPlayer"
        ]
      },
      "Confirm": {
        "type": "object",
        "properties": {
          "documentId": {
            "type": "string"
          }
        },
        "required": [
          "documentId"
        ]
      },
      "Confirmed": {
        "type": "object",
        "properties": {
          "document": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Document"
              },
              {
                "type": "null"
              }
            ]
          },
          "status": {
            "type": "string"
          }
        },
        "required": [
          "status"
        ]
      },
      "Document": {
        "type": "object",
        "properties": {
          "documentId": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "uploadedAt": {
            "type": "string"
          },
          "reviewedAt": {
            "type": [
              "string",
              "null"
            ]
          },
          "reasonCode": {
            "type": [
              "string",
              "null"
            ]
          },
          "submittedBy": {
            "type": "string"
          },
          "reviewedBy": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "documentId",
          "category",
          "status",
          "uploadedAt",
          "submittedBy"
        ]
      },
      "Documents": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "mode": {
            "type": "string"
          },
          "categories": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CategoryRow"
            }
          },
          "other": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Document"
            }
          },
          "missingProfileFields": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "status",
          "mode"
        ]
      },
      "Offered": {
        "type": "object",
        "properties": {
          "documentId": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "objectName": {
            "type": "string"
          },
          "contentType": {
            "type": "string"
          },
          "expiresAt": {
            "type": "string"
          }
        },
        "required": [
          "documentId",
          "url",
          "objectName",
          "contentType",
          "expiresAt"
        ]
      },
      "Refusal": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          },
          "message": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "error"
        ]
      },
      "Requirements": {
        "type": "object",
        "properties": {
          "requiredDocTypes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "Upload": {
        "type": "object",
        "properties": {
          "category": {
            "type": "string"
          },
          "contentType": {
            "type": "string"
          }
        },
        "required": [
          "category",
          "contentType"
        ]
      },
      "View": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          },
          "expiresAt": {
            "type": "string"
          }
        },
        "required": [
          "url",
          "expiresAt"
        ]
      }
    }
  }
}
