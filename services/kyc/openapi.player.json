        "operationId": "get_v1_casino_kyc_requirements_the_brand",
        "summary": "The document categories the brand requires",
        "tags": [
          "player"
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Requirements"
                }
              }
            }
          },
          "default": {
            "description": "refused",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Refusal"
                }
              }
            }
          }
        },
        "security": [
          
        ]
      }
    },
